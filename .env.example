# 星靈織語 Starwoven — 環境變數範例配置
# 複製此檔為 .env 並填入實際值（.env 已被 .gitignore 忽略，不會上傳至 GitHub）

# Google Analytics 4 Measurement ID（格式為 G-XXXXXXXXXX）
PUBLIC_GA_ID=G-XXXXXXXXXX

# 課程許願池（敲碗開課）Google Apps Script Web App URL
# 部署 Apps Script 後填入（形如 https://script.google.com/macros/s/XXX/exec）
# 留空時前端進入 Demo 模式：票數僅存訪客本機 localStorage，不送出網路請求
PUBLIC_WISHLIST_API_URL=

# =========================================================
# AI 互動功能（線上塔羅抽卡、線上占星抽卡）— 伺服器端變數（DEC-073、DEC-079、DEC-080，規格見 demo_docs/ai_platform_plan.md）
# ⚠️ 不得以 PUBLIC_ 開頭；只在伺服器執行期讀取，不會打包進前端
# 變數清單之單一來源為 astro.config.mjs 的 env.schema；未填的項目套用預設值
# 本機：貼到專案根目錄 .env；VPS：放 /etc/starwoven/app.env（權限 600，另加 HOST／PORT）
# =========================================================

# ---- 共用：AI 供應商（全部 AI 功能共用同一組） ----

# AI 金鑰（選填；留空 → 全部 AI 功能自動停用，其餘頁面與 build 不受影響）
AI_API_KEY=

# AI 供應商（MVP 唯一合法值 openai-compatible）
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.minimax.io/v1
AI_MODEL=MiniMax-M3.1-Flash

# 推理強度：none / low / medium / high / xhigh / max（none = 不送出此參數；留空無效，會套用預設 low）
AI_REASONING_EFFORT=low

# ---- 線上塔羅抽卡 ----

# 功能開關（false → API 回 DISABLED，前端顯示「抽卡功能暫停中」）
TAROT_ENABLED=true

# 每日上限（台灣時間 00:00 重置；與其他 AI 功能分開計算）：全站總次數／每個 IP 次數
TAROT_DAILY_LIMIT=300
TAROT_IP_DAILY_LIMIT=10

# ---- 線上占星抽卡（DEC-080） ----

# 功能開關（false → API 回 DISABLED，前端顯示「占星抽卡暫停中」；塔羅不受影響）
ASTROCARDS_ENABLED=true

# 每日上限（台灣時間 00:00 重置；與塔羅分開計算）：全站總次數／每個 IP 次數；未設定則套用預設值
ASTROCARDS_DAILY_LIMIT=300
ASTROCARDS_IP_DAILY_LIMIT=10
