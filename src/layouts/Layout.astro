      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        
        <!-- 1. 大標題：聯絡我們 -->
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-wider font-huninn text-center mb-10 sm:mb-14 text-[#2E2A4F] dark:text-white transition-colors">
          聯絡我們
