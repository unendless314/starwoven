---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  theme?: 'dark' | 'light' | 'auto';
}

const {
  title = '星靈織語 Starwoven — 每一段相遇，都是一場心靈的編織',
  description = '星靈織語提供命理與占卜服務，包含塔羅、占星、八字、靈氣調頻與阿卡西紀錄，陪伴你探索生命可能，找到心靈方向。',
  ogImage = '/assets/og-image.jpg',
  theme = 'auto',
} = Astro.props;

const siteName = '星靈織語 Starwoven';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://starwoven.xyz');
const isDark = theme === 'dark' || (theme === 'auto' && (Astro.url.pathname === '/' || Astro.url.pathname === ''));
---

<!DOCTYPE html>
<html lang="zh-Hant" class:list={['h-full', isDark && 'dark']} data-theme={isDark ? 'dark' : 'light'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%238FB8E8'><path d='M12.3 2a10 10 0 0 0-.19 20 10 10 0 0 0 8.89-5.4 1 1 0 0 0-1.04-1.42 8 8 0 1 1-7.66-13.18 1 1 0 0 0-.01-1.99c.01 0 .01 0 0 0z'/></svg>" />

    <!-- Google Fonts: Huninn (粉圓體) + Quicksand + Nunito -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Huninn&family=Nunito:wght@400;600;700&family=Quicksand:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Dark / Light Theme Initialization Script (Instant FOUC Prevention) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('starwoven_theme');
          const isHome = window.location.pathname === '/' || window.location.pathname === '';
          const theme = (stored === 'dark' || stored === 'light') ? stored : (isHome ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>

    <!-- GA_MEASUREMENT_ID -->
    <!-- Google Analytics: Replace with actual ID when available -->
  </head>

  <body class="min-h-full flex flex-col transition-colors duration-300 bg-[#EAF3F8] text-[#3A3A3A] dark:bg-[#2E2A4F] dark:text-[#F5F5F5]">
    
    <!-- Navbar Component -->
    <Navbar theme={theme} />

    <!-- Main Content Slot -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Global Footer: 精準還原 Canva「聯絡我們」與工作資訊頁尾 -->
    <footer class="w-full transition-colors duration-300 border-t overflow-hidden relative bg-[#DFECF3]/90 text-[#2E2A4F] border-[#80A9D4]/30 dark:bg-[#18152e] dark:text-white dark:border-white/10">
      <!-- 星空/光斑氛圍背景（暗色主題下延伸星空質感） -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#151226] via-[#1c1834] to-[#120f21] -z-20 hidden dark:block transition-opacity"></div>
      <div class="absolute inset-0 pointer-events-none -z-10 hidden dark:block">
        <span class="absolute top-[25%] left-[12%] w-1.5 h-1.5 bg-white/50 rounded-full blur-[0.5px]"></span>
        <span class="absolute top-[60%] right-[18%] w-2 h-2 bg-[#FCE794]/40 rounded-full blur-[0.5px]"></span>
        <span class="absolute bottom-[35%] left-[40%] w-2.5 h-2.5 bg-[#8FB8E8]/40 rounded-full blur-[1px]"></span>
