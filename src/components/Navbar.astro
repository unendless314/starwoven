---
import CTAButton from './CTAButton.astro';

interface Props {
  currentPath?: string;
  theme?: 'dark' | 'light' | 'auto';
}

const { currentPath = Astro.url.pathname, theme = 'auto' } = Astro.props;

// Determine if we should use dark navbar (for homepage) or light navbar (for inner pages)
const isDark = theme === 'dark' || (theme === 'auto' && (currentPath === '/' || currentPath === ''));

const normalizePath = (p: string) => {
  const stripped = p.replace(/\/$/, '');
  return stripped === '' ? '/' : stripped;
};

const normCurrent = normalizePath(currentPath);

const navLinks = [
  { name: '關於我們', href: '/about' },
  { name: '命理服務', href: '/services' },
  { name: '活動與課程', href: '/courses' },
  { name: '靈氣與脈輪', href: '/reiki' },
  { name: '光與阿卡西紀錄', href: '/akashic' },
];
---

<header class="sticky top-0 z-50 w-full transition-colors duration-300 backdrop-blur-md bg-[#EAF3F8]/90 text-[#3A3A3A] border-b border-[#80A9D4]/20 shadow-xs dark:bg-[#2E2A4F]/85 dark:text-white dark:border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-hidden">
        <!-- Logo Icon (Moon & Twinkling Star) -->
        <div class="w-11 h-11 rounded-full flex items-center justify-center transition-transform group-hover:scale-105 shadow-xs bg-[#80A9D4]/15 dark:bg-white/10">
          <svg class="w-7 h-7 text-[#8FB8E8]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.3 2a10 10 0 0 0-.19 20 10 10 0 0 0 8.89-5.4 1 1 0 0 0-1.04-1.42 8 8 0 1 1-7.66-13.18 1 1 0 0 0-.01-1.99c.01 0 .01 0 0 0z" />
            <polygon points="19,4 20,7 23,8 20,9 19,12 18,9 15,8 18,7" class="text-[#FCE794] animate-pulse" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-bold tracking-wider leading-tight text-[#2E2A4F] dark:text-white transition-colors">
            星靈織語
          </span>
          <span class="text-xs tracking-widest uppercase font-light text-[#2E2A4F]/70 dark:text-white/70 transition-colors">
            Starwoven
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8">
        {navLinks.map((item) => {
          const normHref = normalizePath(item.href);
          const isActive = normCurrent === normHref || (normHref !== '/' && normCurrent.startsWith(normHref));
          return (
            <a
              href={item.href}
              class:list={[
                'text-base transition-colors duration-150 py-1 relative tracking-wider',
                isActive
                  ? 'font-semibold text-[#2E2A4F] dark:text-white after:bg-[#80A9D4] dark:after:bg-[#8FB8E8]'
                  : 'text-[#3A3A3A] hover:text-[#2E2A4F] dark:text-white/85 dark:hover:text-white after:bg-[#80A9D4]/40 dark:after:bg-white/40',
                isActive && 'after:content-[""] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:rounded-full'
              ]}
            >
              {item.name}
            </a>
          );
        })}

        <!-- Theme Toggle Button (Desktop) -->
        <button
          id="desktop-theme-toggle"
          type="button"
          aria-label="切換深淺色主題"
          title="切換深淺色主題（夜間 / 日間）"
          class="p-2.5 rounded-full border transition-all duration-300 hover:scale-110 active:scale-95 text-[#2E2A4F] bg-white/70 border-[#80A9D4]/30 hover:bg-white shadow-xs dark:text-[#FCE794] dark:bg-white/10 dark:border-white/20 dark:hover:bg-white/20 cursor-pointer"
        >
          <!-- Sun Icon (Active in dark mode -> click switches to light mode) -->
          <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <!-- Moon Icon (Active in light mode -> click switches to dark mode) -->
          <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>

        <!-- CTA Button in Desktop Nav -->
        <div class="ml-1">
          <CTAButton variant="nav" text="預約諮詢" />
        </div>
      </nav>

      <!-- Mobile Actions (Theme Toggle + CTA + Hamburger) -->
      <div class="flex lg:hidden items-center gap-2">
        <!-- Theme Toggle Button (Mobile) -->
        <button
          id="mobile-theme-toggle"
          type="button"
          aria-label="切換深淺色主題"
          title="切換深淺色主題"
          class="p-2 rounded-full border transition-all duration-200 text-[#2E2A4F] bg-white/70 border-[#80A9D4]/30 dark:text-[#FCE794] dark:bg-white/10 dark:border-white/20 cursor-pointer"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>

        <CTAButton variant="nav" text="預約" class="text-xs px-3.5 py-1.5 sm:inline-flex" />
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="切換選單"
          aria-expanded="false"
          class="p-2 rounded-lg transition-colors focus:outline-hidden text-[#3A3A3A] hover:bg-[#80A9D4]/15 dark:text-white dark:hover:bg-white/10"
        >
          <svg id="menu-open-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t px-6 py-5 transition-all duration-200 bg-[#EAF3F8] border-[#80A9D4]/20 text-[#3A3A3A] dark:bg-[#2E2A4F] dark:border-white/10 dark:text-white"
  >
    <div class="flex flex-col space-y-3">
      {navLinks.map((item) => {
        const normHref = normalizePath(item.href);
        const isActive = normCurrent === normHref || (normHref !== '/' && normCurrent.startsWith(normHref));
        return (
          <a
            href={item.href}
            class:list={[
              'text-lg py-2 px-3 rounded-md transition-colors tracking-wide',
              isActive
                ? 'bg-[#80A9D4]/20 text-[#2E2A4F] font-semibold dark:bg-white/15 dark:text-white'
                : 'text-[#3A3A3A] hover:bg-[#80A9D4]/10 hover:text-[#2E2A4F] dark:text-white/80 dark:hover:bg-white/10 dark:hover:text-white'
            ]}
          >
            {item.name}
          </a>
        );
      })}
      <div class="pt-3 border-t border-current/10">
        <CTAButton variant="primary" text="預約諮詢" class="w-full justify-center py-3" />
      </div>
    </div>
  </div>
</header>

<script>
  function setupThemeToggle() {
    const desktopBtn = document.getElementById('desktop-theme-toggle');
    const mobileBtn = document.getElementById('mobile-theme-toggle');

    function toggle() {
      const isDark = document.documentElement.classList.toggle('dark');
      const newTheme = isDark ? 'dark' : 'light';
      try {
        localStorage.setItem('starwoven_theme', newTheme);
      } catch (e) {}
      document.documentElement.setAttribute('data-theme', newTheme);
    }

    desktopBtn?.addEventListener('click', toggle);
    mobileBtn?.addEventListener('click', toggle);
  }

  function setupMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-open-icon');
    const closeIcon = document.getElementById('menu-close-icon');

    if (!toggleBtn || !mobileMenu || !openIcon || !closeIcon) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const willExpand = !isExpanded;
      toggleBtn.setAttribute('aria-expanded', String(willExpand));
      
      mobileMenu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
      document.body.classList.toggle('overflow-hidden', willExpand);
    });

    // Close menu when link is clicked
    const links = mobileMenu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
      });
    });
  }

  // Setup on page load and on view transitions (if any)
  setupThemeToggle();
  setupMenu();
  document.addEventListener('astro:page-load', () => {
    setupThemeToggle();
    setupMenu();
  });
