---
// ==========================================
// 課程許願池卡片（敲碗開課）v2 — 版型與樣式（單一版型來源）
// - 本元件僅含卡片標記與樣式；全部互動邏輯（get_all 同步、投票、骨架卡、Demo 模式）
//   位於 src/scripts/wishlist.ts，由 wishlist.astro 以頁面層級 <script> 引入
//   （不可移回本元件：元件僅被 <template> 使用時，Astro 會把元件 <script> 標籤
//   插進 <template> 內成為 inert，永不執行）
// - 掛勾 class 與 data 屬性為腳本介面（wish-title／wish-price／data-wish-hero 等），
//   更名需同步 wishlist.ts（詳 course_wishlist_plan_v3.md 第四節）
// ==========================================
interface Props {
  id: string;
  title: string;
  teacher: string;
  price: string;
  votes: number;
  threshold: number;
  icon: string;
  gradient: string;
}

const { id, title, teacher, price, votes, threshold, icon, gradient } = Astro.props;
const reached = votes >= threshold;
const percent = Math.min(100, Math.round((votes / threshold) * 100));
---

<div
  class="wish-card group bg-white/95 dark:bg-[#231f40]/95 backdrop-blur-md rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 border border-gray-200/80 dark:border-white/20 flex flex-col"
  data-wish-card
  data-course-id={id}
  data-course-name={title}
  data-votes={votes}
  data-threshold={threshold}
>
  <!-- 意象區：漸層底色 + 預定價格標籤 + 許願人數膠囊 -->
  <div data-wish-hero class:list={['relative w-full aspect-16/10 bg-gradient-to-br flex items-center justify-center overflow-hidden', gradient]}>
    <span class="absolute -top-6 -left-6 w-24 h-24 bg-white/25 rounded-full blur-2xl"></span>
    <span class="absolute bottom-2 right-4 w-16 h-16 bg-white/20 rounded-full blur-xl"></span>

    <!-- 預定價格標籤（左上；留空時隱藏，待試算表 I 欄 get_all 覆寫） -->
    <span class:list={['wish-price absolute top-3 left-3 z-10 text-[11px] sm:text-xs font-bold px-2.5 py-1 rounded-full bg-[#2E2A4F]/85 text-white tracking-wider shadow-sm', { hidden: !price }]}>
      {price}
    </span>

    <!-- 許願人數膠囊（右上） -->
    <span class="absolute top-3 right-3 z-10 text-[11px] sm:text-xs font-bold px-3 py-1 rounded-full bg-[#FCE794] text-[#2E2A4F] tracking-wider shadow-md flex items-center gap-1">
      <span aria-hidden="true">🔥</span>
      <span class="wish-pill-count inline-block">{votes}</span>
      <span>人想上</span>
    </span>

    <!-- 主視覺符號 -->
    <span class="wish-icon text-6xl sm:text-7xl drop-shadow-[0_6px_16px_rgba(255,255,255,0.45)] group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-500 select-none" aria-hidden="true">{icon}</span>
  </div>

  <!-- 資訊區 -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col gap-3">
    <div>
      <h3 class="wish-title text-lg sm:text-xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wide transition-colors">{title}</h3>
      <p class="text-xs sm:text-sm text-[#3A3A3A]/70 dark:text-white/70 mt-1 font-huninn tracking-wider transition-colors">企劃講師｜<span class="wish-teacher">{teacher}</span></p>
    </div>

    <!-- 進度條 -->
    <div class="space-y-1.5">
      <div class="w-full h-2.5 rounded-full bg-[#3A3A3A]/10 dark:bg-white/15 overflow-hidden">
        <div
          class:list={['wish-bar-fill h-full rounded-full transition-all duration-500', reached ? 'bg-[#58A497]' : 'bg-[#F5A623]']}
          style={`width: ${percent}%`}
        ></div>
      </div>
      <div class="flex items-center justify-between text-xs sm:text-sm">
        <span class="text-[#3A3A3A]/75 dark:text-white/75 font-medium transition-colors">
          <span class="wish-progress-text">{votes} / {threshold}</span> 人許願
        </span>
        <span class:list={['wish-reached font-bold text-[#58A497]', reached ? '' : 'hidden']}>✓ 達標籌備中</span>
      </div>
    </div>

    <!-- 許願按鈕 -->
    <button
      type="button"
      class="wish-btn mt-auto w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full bg-[#80A9D4] hover:bg-[#6b97c4] text-white text-sm sm:text-base font-bold font-huninn tracking-widest shadow-sm hover:shadow-md transition-all duration-200 active:scale-95 cursor-pointer"
    >
      <span class="wish-btn-label">✦ 我想一起</span>
    </button>
  </div>
</div>

<style>
  .wish-pill-count.wish-pop {
    animation: wishPop 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes wishPop {
    0% { transform: scale(1); }
    40% { transform: scale(1.6); }
    100% { transform: scale(1); }
  }

  .wish-btn:disabled {
    cursor: default;
  }

  .wish-btn.is-pending {
    opacity: 0.75;
    animation: wishPulse 1.2s ease-in-out infinite;
  }
  @keyframes wishPulse {
    0%, 100% { opacity: 0.75; }
    50% { opacity: 0.45; }
  }

  .wish-btn.is-voted {
    background-color: #FCE794;
    color: #2E2A4F;
    box-shadow: 0 0 18px rgba(252, 231, 148, 0.55);
  }

  .wish-btn.is-retry {
    background: transparent;
    color: #B45309;
    border: 1.5px solid #F5A623;
    box-shadow: none;
  }

  .wish-btn.is-closed {
    background-color: #58A497;
    color: #fff;
  }
</style>
