---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';

const benefits = [
  { chakra: '穩定海底輪', desc: '調和海底輪能幫助你落地接地氣，建立內在的不動如山感，打造心理安全感，告別裁員與經濟焦慮，不再隨外在環境輕易動搖。' },
  { chakra: '活化臍輪', desc: '當臍輪能量流暢，能重新激發你的好奇心，找回工作熱情與靈感、創造力與對生活的情感，打破倦怠期！' },
  { chakra: '強化太陽神經叢', desc: '覺察這個區域，能幫助你找回掌控感與行動力，提升執行力與職場自信，不再被冒牌者症候群綁架。' },
  { chakra: '打開心輪', desc: '心輪流暢能讓你保持同理心與界線，減少情緒勒索與無謂的對立內耗，建立和諧的協作關係，改善人際關係，放下辦公室政治內耗。' },
  { chakra: '通暢喉輪', desc: '無論是向主管彙報、跨部門溝通還是談判，喉輪平衡能讓你自信且清晰地說出真實想法，既不懦弱委屈，也不過度激進，清晰溝通，精準表達訴求。' },
  { chakra: '覺察眉心輪與頂輪', desc: '面對海量資訊與複雜決策，強大的直覺與高維度的洞察力能幫你穿透迷霧，做出最明智的選擇，並在下班後快速「離線」，獲得深度休息。' },
];
---

<Layout
  title="靈氣與脈輪 — 星靈織語 Starwoven"
  description="認識臼井靈氣與七脈輪身心自我檢測系統，透過身心調頻舒緩上班族日常焦慮，找回內在平靜與生活能量。"
  theme="light"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <header class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <h1 class="text-3xl sm:text-4xl font-bold text-[#2E2A4F] tracking-wider">靈氣與脈輪課程</h1>
      <p class="text-base text-[#80A9D4] font-medium">授課講師：曉宇老師、達心老師</p>
      <p class="text-lg text-[#3A3A3A]/80 leading-relaxed">
        建立一套專屬於你的「身心自我檢測系統」，從忙碌與緊繃中重新歸零。
      </p>
      <div class="w-16 h-1 bg-[#80A9D4] mx-auto rounded-full"></div>
    </header>

    <!-- Intro Sections -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <div class="bg-white/80 p-8 rounded-3xl border border-[#80A9D4]/20 shadow-xs space-y-4">
        <h2 class="text-2xl font-bold text-[#2E2A4F]">臼井靈氣簡介</h2>
        <p class="text-base text-[#3A3A3A]/85 leading-relaxed">
          臼井靈氣源自日本，由臼井甕男（Mikao Usui）發展，常被用作一種放鬆、靜心與自我覺察的練習。
        </p>
        <p class="text-base text-[#3A3A3A]/85 leading-relaxed">
          你不需要先相信它很神奇，只需要帶著一點好奇：「當我們真正安靜下來，會發現自己的身體與情緒嗎？」透過手部放置與靜心修習，培養對身心狀態的深度覺知。
        </p>
      </div>

      <div class="bg-white/80 p-8 rounded-3xl border border-[#80A9D4]/20 shadow-xs space-y-4">
        <h2 class="text-2xl font-bold text-[#2E2A4F]">為什麼要瞭解七脈輪？</h2>
        <p class="text-base text-[#3A3A3A]/85 leading-relaxed">
          七脈輪更像是一套「身心自我檢測系統」。人們往往習慣於「頭腦決定一切」，忽視了身體發出的訊號。
        </p>
        <p class="text-base text-[#3A3A3A]/85 leading-relaxed">
          當感到莫名焦慮、提不起勁時，能透過脈輪地圖定位失衡的能量樞紐進行調頻，舒緩身心不適，維持能量穩定。
        </p>
      </div>
    </div>

    <!-- Benefits for Office Workers -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-[#2E2A4F] mb-8 text-center">對一般上班族的調適助益</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((item) => (
          <div class="bg-white/80 p-6 rounded-2xl border border-[#80A9D4]/20 shadow-xs space-y-2">
            <h3 class="text-lg font-bold text-[#2E2A4F] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#80A9D4]"></span>
              {item.chakra}
            </h3>
            <p class="text-sm text-[#3A3A3A]/80 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <div class="text-center bg-white/60 p-8 rounded-3xl border border-[#80A9D4]/20 max-w-xl mx-auto space-y-4">
      <h2 class="text-xl font-bold text-[#2E2A4F]">星靈織語提供靈氣點化與調頻服務</h2>
      <p class="text-sm text-[#3A3A3A]/80">歡迎加入 LINE 官方帳號私訊詢問課程與預約詳情。</p>
      <CTAButton variant="primary" text="私訊預約與詢問" />
    </div>
  </div>
</Layout>
