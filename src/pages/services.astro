---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
---

<Layout
  title="命理服務 — 星靈織語 Starwoven"
  description="選擇適合你的命理陪伴，讓每一次探索都能更靠近真實的自己。提供星盤解析、塔羅占卜、生命靈數、八字命理、靈氣調頻與阿卡西紀錄解讀。"
  theme="light"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <header class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <h1 class="text-3xl sm:text-4xl font-bold text-[#2E2A4F] tracking-wider">命理服務</h1>
      <p class="text-lg text-[#3A3A3A]/80 leading-relaxed">
        選擇適合你的命理陪伴，讓每一次探索，都能更靠近真實的自己。
      </p>
      <div class="w-16 h-1 bg-[#80A9D4] mx-auto rounded-full"></div>
    </header>

    <!-- Services Overview Preview (Phase 1 Skeleton) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {[
        { title: '星盤解析', desc: '通話語音 / 面對面解析（工作室）', price: '30分鐘 800元 / 60分鐘 1500元' },
        { title: '塔羅占卜', desc: '偉特塔羅 / 托特塔羅 / 離線文字占卜', price: '300元/題起 · 30分鐘 600元' },
        { title: '生命靈數', desc: '通話語音 / 面對面解析（工作室）', price: '30分鐘 800元 / 60分鐘 1500元' },
        { title: '八字命理', desc: '通話語音 / 面對面解析（工作室）', price: '30分鐘 800元 / 60分鐘 1500元' },
        { title: '靈氣調頻', desc: '工作室面對面身心靈能量療癒', price: '30分鐘 800元 / 60分鐘 1500元' },
        { title: '阿卡西紀錄', desc: '通話語音 / 面對面深度靈性解讀', price: '30分鐘 800元 / 60分鐘 1500元' },
      ].map((item) => (
        <div class="bg-white/80 backdrop-blur-xs p-6 rounded-2xl border border-[#80A9D4]/20 shadow-xs hover:shadow-md transition-shadow">
          <h3 class="text-xl font-bold text-[#2E2A4F] mb-2">{item.title}</h3>
          <p class="text-sm text-[#3A3A3A]/75 mb-4">{item.desc}</p>
          <div class="text-sm font-semibold text-[#80A9D4] pt-2 border-t border-gray-100">{item.price}</div>
        </div>
      ))}
    </div>

    <!-- CTA Section -->
    <div class="mt-16 text-center bg-white/60 p-8 rounded-3xl border border-[#80A9D4]/20 max-w-xl mx-auto space-y-4">
      <h2 class="text-xl font-bold text-[#2E2A4F]">準備好開啟您的心靈對話了嗎？</h2>
      <p class="text-sm text-[#3A3A3A]/80">點選下方按鈕加入官方 LINE，專人為您安排預約諮詢時間。</p>
      <CTAButton variant="primary" text="點選預約" />
    </div>
  </div>
</Layout>
