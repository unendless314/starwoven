---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';

// ==========================================
// 命理服務卡片插圖路徑配置（ComfyUI 生圖或取得真圖後填入）
// 例如：const imgTarot = '/assets/services_a_tarot_v1.png';
// 若為空字串，將自動呈現精美手繪風格 SVG 佔位符與代碼標籤
// ==========================================
const imgTarot = '/assets/services_a_tarot_v1.webp';       // 服務-A：塔羅占卜手繪插圖
const imgAstrology = '/assets/services_b_astrology_v1.webp';   // 服務-B：星盤解析手繪插圖
const imgNumerology = '/assets/services_c_numerology_v1.webp';  // 服務-C：生命靈數手繪插圖
const imgBazi = '/assets/services_d_bazi_v1.webp';        // 服務-D：八字命理手繪插圖
const imgReiki = '/assets/services_e_reiki_v1.webp';       // 服務-E：靈氣調頻手繪插圖
const imgAkashic = '/assets/services_f_akashic_v1.webp';     // 服務-F：阿卡西紀錄手繪插圖
const imgPet = '/assets/services_g_pet_v1.webp';             // 服務-G：毛孩溝通手繪插圖

interface PractitionerGroup {
  system?: string;         // 例如：'偉特塔羅'、'托特塔羅'
  names: string[];
}

interface ServiceCard {
  code: string;
  title: string;
  image: string;
  iconType: 'tarot' | 'astrology' | 'numerology' | 'bazi' | 'reiki' | 'akashic' | 'pet';
  modalities: string[];    // 預約形式：通話語音 / 面對面 / 離線文字
  prices: {
    label: string;
    rate: string;
  }[];
  overtimeNote?: string;   // 超時備註
  roleTitle: string;       // 可預約老師稱號
  practitioners: PractitionerGroup[];
}

const services: ServiceCard[] = [
  {
    code: '服務-A',
    title: '塔羅占卜',
    image: imgTarot,
    iconType: 'tarot',
    modalities: ['離線文字占卜', '語音占卜', '面對面占卜（工作室）'],
    prices: [
      { label: '離線文字占卜', rate: '一題 300元' },
      { label: '語音和面對面占卜', rate: '半小時 600元' },
    ],
    roleTitle: '可預約占卜師',
    practitioners: [
      { system: '偉特塔羅', names: ['以恩', '達達'] },
      { system: '托特塔羅', names: ['學長', '悠悠'] },
    ],
  },
  {
    code: '服務-B',
    title: '星盤解析',
    image: imgAstrology,
    iconType: 'astrology',
    modalities: ['通話語音解析', '面對面解析（工作室）'],
    prices: [
      { label: '通話語音 / 面對面解析', rate: '30分鐘 800元 · 60分鐘 1500元' },
    ],
    overtimeNote: '超時以30分鐘計',
    roleTitle: '可預約命理師',
    practitioners: [
      { names: ['皮皮', '以恩', '學長', '古古'] },
    ],
  },
  {
    code: '服務-C',
    title: '生命靈數',
    image: imgNumerology,
    iconType: 'numerology',
    modalities: ['通話語音解析', '面對面解析（工作室）'],
    prices: [
      { label: '通話語音 / 面對面解析', rate: '30分鐘 800元 · 60分鐘 1500元' },
    ],
    overtimeNote: '超時以30分鐘計',
    roleTitle: '可預約命理師',
    practitioners: [
      { names: ['皮皮'] },
    ],
  },
  {
    code: '服務-D',
    title: '八字命理',
    image: imgBazi,
    iconType: 'bazi',
    modalities: ['通話語音解析', '面對面解析（工作室）'],
    prices: [
      { label: '通話語音 / 面對面解析', rate: '30分鐘 800元 · 60分鐘 1500元' },
    ],
    overtimeNote: '超時以30分鐘計',
    roleTitle: '可預約命理師',
    practitioners: [
      { names: ['達達'] },
    ],
  },
  {
    code: '服務-E',
    title: '靈氣與光調頻',
    image: imgReiki,
    iconType: 'reiki',
    modalities: ['工作室面對面療癒'],
    prices: [
      { label: '工作室面對面療癒', rate: '30分鐘 800元 · 60分鐘 1500元' },
    ],
    roleTitle: '可預約調頻師',
    practitioners: [
      { names: ['以恩', '皮皮', '學長', '達達', '古古', '月月', '白白'] },
    ],
  },
  {
    code: '服務-F',
    title: '阿卡西紀錄',
    image: imgAkashic,
    iconType: 'akashic',
    modalities: ['通話語音解讀', '面對面解讀（工作室）'],
    prices: [
      { label: '通話語音 / 面對面解讀', rate: '30分鐘 800元 · 60分鐘 1500元' },
    ],
    overtimeNote: '超時以15分鐘計',
    roleTitle: '可預約阿卡西解讀師',
    practitioners: [
      { names: ['以恩', '古古'] },
    ],
  },
  {
    code: '服務-G',
    title: '毛孩溝通',
    image: imgPet,
    iconType: 'pet',
    modalities: ['通話語音溝通', '面對面溝通（工作室）'],
    prices: [
      { label: '通話語音 / 面對面溝通', rate: '30分鐘 600元 · 60分鐘 1200元' },
    ],
    roleTitle: '可預約毛孩溝通師',
    practitioners: [
      { names: ['以恩', '古古'] },
    ],
  },
];
---

<Layout
  title="命理服務 — 星靈織語 Starwoven"
  description="選擇適合你的命理陪伴，讓每一次探索都能更靠近真實的自己。提供星盤解析、塔羅占卜、生命靈數、八字命理、靈氣與光調頻、阿卡西紀錄解讀與毛孩溝通。"
  theme="auto"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- Header: 還原 Canva 頁頭標題與手繪感說明 -->
    <header class="text-center max-w-3xl mx-auto mb-16 sm:mb-20 space-y-4">
      <h1 class="text-3xl sm:text-5xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wider transition-colors">
        命理服務
      </h1>
      <p class="text-lg sm:text-xl text-[#3A3A3A]/85 dark:text-white/85 font-light leading-relaxed tracking-wide transition-colors">
        選擇適合你的命理陪伴，<br class="hidden sm:inline" />
        讓每一次探索，都能更靠近真實的自己。
      </p>
      <div class="w-20 h-1.5 bg-[#80A9D4] mx-auto rounded-full mt-3 opacity-80"></div>
    </header>

    <!-- Services Grid: 還原 Canva 2 大欄（雙欄寬幅大卡片）排版與專屬留圖空間 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
      {services.map((item) => (
        <div class="group bg-white/85 dark:bg-white/10 backdrop-blur-md rounded-3xl p-7 sm:p-9 border border-[#80A9D4]/25 dark:border-white/15 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
          
          <div>
            <!-- 1. 卡片頂部：專屬留圖空間（插圖） + 服務大標題 -->
            <div class="flex items-center gap-5 sm:gap-6 pb-6 border-b border-[#80A9D4]/15 dark:border-white/10">
              
              <!-- 留圖空間（Image Slot / Placeholder） -->
              <div class="shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-2xl flex items-center justify-center transition-transform duration-300 group-hover:scale-105">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={`${item.title} 插圖`}
                    class="w-full h-full object-contain mx-auto"
                  />
                ) : (
                  <div class="w-full h-full rounded-2xl border-2 border-dashed border-[#80A9D4]/50 dark:border-white/25 bg-[#EAF3F8]/60 dark:bg-white/5 flex flex-col items-center justify-center p-2 text-center group-hover:border-[#2E2A4F]/50 dark:group-hover:border-white/50 transition-colors">
                    
                    {/* 塔羅牌圖示 */}
                    {item.iconType === 'tarot' && (
                      <svg class="w-10 h-10 text-[#80A9D4] dark:text-[#8FB8E8] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="5" y="3" width="14" height="18" rx="2" />
                        <path d="M12 7v10M8 12h8" stroke-linecap="round" />
                        <circle cx="12" cy="12" r="2" />
                      </svg>
                    )}

                    {/* 星盤解析圖示 */}
                    {item.iconType === 'astrology' && (
                      <svg class="w-10 h-10 text-[#80A9D4] dark:text-[#8FB8E8] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 3a9 9 0 0 1 9 9M3 12a9 9 0 0 0 9 9" stroke-dasharray="2 2" />
                        <ellipse cx="12" cy="12" rx="9" ry="4" transform="rotate(-30 12 12)" />
                      </svg>
                    )}

                    {/* 生命靈數圖示 */}
                    {item.iconType === 'numerology' && (
                      <svg class="w-10 h-10 text-[#80A9D4] dark:text-[#8FB8E8] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <polygon points="12,2 22,19 2,19" />
                        <circle cx="12" cy="12" r="2.5" />
                        <circle cx="12" cy="6" r="1" />
                        <circle cx="7" cy="15" r="1" />
                        <circle cx="17" cy="15" r="1" />
                      </svg>
                    )}

                    {/* 八字命理圖示 */}
                    {item.iconType === 'bazi' && (
                      <svg class="w-10 h-10 text-[#80A9D4] dark:text-[#8FB8E8] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 3a4.5 4.5 0 0 0 0 9 4.5 4.5 0 0 1 0 9" />
                        <circle cx="12" cy="7.5" r="1.5" fill="currentColor" />
                        <circle cx="12" cy="16.5" r="1.5" />
                      </svg>
                    )}

                    {/* 靈氣調頻圖示 */}
                    {item.iconType === 'reiki' && (
                      <svg class="w-10 h-10 text-[#80A9D4] dark:text-[#8FB8E8] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M7 11c0-2.5 2-4.5 5-4.5s5 2 5 4.5" />
                        <path d="M5 14c0 3 3.5 6 7 6s7-3 7-6" />
                        <circle cx="12" cy="4" r="1.5" fill="currentColor" />
                        <path d="M12 7v4" />
                      </svg>
                    )}

                    {/* 阿卡西紀錄圖示 */}
                    {item.iconType === 'akashic' && (
                      <svg class="w-10 h-10 text-[#80A9D4] dark:text-[#8FB8E8] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                        <path d="M10 7h6M10 11h4" stroke-linecap="round" />
                      </svg>
                    )}

                    {/* 毛孩溝通圖示 */}
                    {item.iconType === 'pet' && (
                      <svg class="w-10 h-10 text-[#80A9D4] dark:text-[#8FB8E8] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 13.5c-2.4 0-4.5 1.5-4.5 3.3 0 1.6 1.9 2.7 4.5 2.7s4.5-1.1 4.5-2.7c0-1.8-2.1-3.3-4.5-3.3z" />
                        <circle cx="7" cy="10.5" r="1.5" />
                        <circle cx="10.3" cy="7.8" r="1.5" />
                        <circle cx="13.7" cy="7.8" r="1.5" />
                        <circle cx="17" cy="10.5" r="1.5" />
                      </svg>
                    )}

                    <span class="text-[10px] font-semibold text-[#2E2A4F]/70 dark:text-white/70 tracking-wider">
                      {item.code}
                    </span>
                  </div>
                )}
              </div>

              <!-- 標題與裝飾線 -->
              <div class="flex-1">
                <h2 class="text-2xl sm:text-3xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wider transition-colors">
                  {item.title}
                </h2>
                <!-- 手繪微光底線 -->
                <div class="w-24 sm:w-32 h-1 bg-gradient-to-r from-[#80A9D4] to-transparent rounded-full mt-2"></div>
                <!-- 預約形式膠囊標籤 -->
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {item.modalities.map((mode) => (
                    <span class="text-xs bg-[#EAF3F8] dark:bg-white/10 text-[#2E2A4F]/80 dark:text-white/80 px-2.5 py-0.5 rounded-full font-medium transition-colors">
                      {mode}
                    </span>
                  ))}
                </div>
              </div>

            </div>

            <!-- 2. 卡片中部：收費標準區塊 -->
            <div class="mt-6 p-4 sm:p-5 rounded-2xl bg-[#EAF3F8]/70 dark:bg-white/5 border border-[#80A9D4]/20 dark:border-white/10 space-y-2.5 transition-colors">
              <div class="text-xs font-semibold uppercase tracking-wider text-[#80A9D4] dark:text-[#8FB8E8] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#80A9D4] dark:bg-[#8FB8E8]"></span>
                收費標準
              </div>
              <div class="space-y-1.5">
                {item.prices.map((p) => (
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between text-sm sm:text-base font-semibold text-[#2E2A4F] dark:text-white">
                    <span class="opacity-90">{p.label}</span>
                    <span class="text-[#2E2A4F] dark:text-[#FCE794] font-bold mt-0.5 sm:mt-0">{p.rate}</span>
                  </div>
                ))}
              </div>
              {item.overtimeNote && (
                <p class="text-xs text-[#3A3A3A]/70 dark:text-white/60 pt-1 border-t border-current/10">
                  ＊ {item.overtimeNote}
                </p>
              )}
            </div>

          </div>

          <!-- 3. 卡片底部：可預約占卜師 / 命理師團隊（原站特色名單） -->
          <div class="mt-7 pt-5 border-t border-gray-100 dark:border-white/10">
            <div class="text-xs sm:text-sm font-semibold text-[#80A9D4] dark:text-[#8FB8E8] flex items-center gap-1.5 mb-3">
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 20 20">
                <path d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 2.052 4.103a1 1 0 01-.894 1.386H2.628a1 1 0 01-.894-1.386l2.052-4.103-1.233-.616a1 1 0 11.894-1.79l1.599.8L9 4.323V3a1 1 0 011-1z" />
              </svg>
              <span>{item.roleTitle}</span>
            </div>

            <div class="space-y-2">
              {item.practitioners.map((group) => (
                <div class="flex flex-wrap items-center gap-2">
                  {group.system && (
                    <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-[#80A9D4]/20 text-[#2E2A4F] dark:bg-white/20 dark:text-white shrink-0">
                      {group.system}
                    </span>
                  )}
                  <div class="flex flex-wrap gap-1.5">
                    {group.names.map((name) => (
                      <span class="px-3 py-1 rounded-full text-xs sm:text-sm font-medium bg-white dark:bg-white/10 border border-[#80A9D4]/25 dark:border-white/15 text-[#2E2A4F] dark:text-white shadow-2xs">
                        {name}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- CTA Section: 還原 Canva 頁尾引導預約諮詢區塊 -->
    <div class="mt-16 sm:mt-24 text-center bg-white/70 dark:bg-white/10 backdrop-blur-md p-8 sm:p-12 rounded-3xl border border-[#80A9D4]/25 dark:border-white/15 max-w-2xl mx-auto space-y-4 shadow-sm transition-colors">
      <h2 class="text-2xl sm:text-3xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wider transition-colors">
        準備好開啟您的心靈對話了嗎？
      </h2>
      <p class="text-base text-[#3A3A3A]/80 dark:text-white/80 leading-relaxed font-light transition-colors">
        點選下方按鈕加入官方 LINE，專人為您安排預約諮詢時間。
      </p>
      <div class="pt-2">
        <CTAButton variant="hero" text="立即預約諮詢" />
      </div>
    </div>
  </div>
</Layout>
