---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';

// ==========================================
// 課程與活動圖片素材路徑配置（ComfyUI 生圖或取得真圖後填入）
// 若為空字串，將自動呈現精美手繪風格 SVG 佔位符與代碼標籤
// ==========================================

// 【1. 固定循環課程現場照片（6張）】
const imgCourseAkashic = '/assets/courses_a_akashic_v1.webp';    // 課程-A：光與阿卡西紀錄現場照片
const imgCourseAstrology = '/assets/courses_b_astrology_v1.webp';  // 課程-B：占星循環班現場照片
const imgCourseWaite = '/assets/courses_c_waite_v1.webp';      // 課程-C：偉特塔羅團練現場照片
const imgCourseReiki = '/assets/courses_d_reiki_v1.webp';      // 課程-D：七脈輪與靈氣現場照片
const imgCourseThoth = '/assets/courses_e_thoth_v1.webp';      // 課程-E：托特塔羅循環班現場照片
const imgCourseNumerology = '/assets/courses_f_numerology_v1.webp'; // 課程-F：生命靈數循環班現場照片

// 【2. 交流會現場照片】
const imgMeetup = '/assets/courses_g_meetup_v1.webp';           // 課程-G：命理交流會現場照片

// 【3. 精選主題體驗課程情境海報（3張）】
const imgWorkshopMeihua = '';   // 課程-H：塏易學 梅花易數情境海報
const imgWorkshopBazi = '';     // 課程-I：八字體驗情境海報
const imgWorkshopZiwei = '';    // 課程-J：紫微斗數工作坊情境海報

// 固定循環課程資料
const recurringCourses = [
  {
    id: 'mon',
    code: '課程-A',
    day: '每週一',
    dayColor: 'bg-[#80A9D4] text-white',
    title: '光與阿卡西紀錄',
    teacher: '古古老師',
    time: '20:00 - 23:00',
    price: '包月四堂 2000元',
    priceNote: '平均每堂 500元',
    extraNote: '可單報阿卡西紀錄團練（20:00-21:00 包月四堂1000元）',
    description: '結合光的靜心冥想與阿卡西紀錄解讀技巧，每週帶領學員穩定能量中軸、清理情緒印記，並練習開啟個人的阿卡西紀錄，探索生命議題的根源解答與內在力量。',
    highlights: ['13 道光的能量靜心與氣場調頻', '阿卡西靈魂紀錄開啟與提問心法', '雙人練習與日常自我能量療癒'],
    suitableFor: '渴望深度向內探索、尋求生命解答、或對能量療癒有興趣的朋友。',
    image: imgCourseAkashic,
    icon: 'akashic',
  },
  {
    id: 'tue',
    code: '課程-B',
    day: '每週二',
    dayColor: 'bg-[#9880B8] text-white',
    title: '占星循環班',
    teacher: '皮皮老師',
    time: '20:00 - 23:00',
    price: '包月四堂 2000元',
    priceNote: '平均每堂 500元',
    extraNote: '第一次包月報名送 1.5 小時個人基礎加強',
    description: '以循序漸進的實務教學，陪伴學員從本命盤的基礎結構入門，透過大量真實案例演練與互相探討，學會讀懂個人性格天賦、人際相處模式與生命週期流年運勢。',
    highlights: ['十大行星與十二星座原型的深度剖析', '後天十二宮位與重要交角相位解析', '真實星盤實戰演練與合盤概念入門'],
    suitableFor: '想有系統學習西洋占星、讀懂自己與他人本命星盤的初學及進階者。',
    image: imgCourseAstrology,
    icon: 'astrology',
  },
  {
    id: 'wed',
    code: '課程-C',
    day: '每週三',
    dayColor: 'bg-[#5B8EA6] text-white',
    title: '偉特塔羅團練',
    teacher: '以恩老師',
    time: '20:00 - 21:30',
    price: '包月四堂 1200元',
    priceNote: '平均每堂 300元',
    description: '每週精選多元現實生活議題（感情發展、職場決策、心靈迷惘），由以恩老師親自引導進行排陣、牌意串聯與盲測實練，在支持性小班氛圍中快速建立敏銳解牌直覺。',
    highlights: ['經典實用牌陣解析與多牌串聯技巧', '盲抽實戰演練與即時反饋調整', '占卜師提問應對與同理心引導心法'],
    suitableFor: '已具備基本偉特塔羅概念，渴望累積實戰解牌經驗與突破盲點的學習者。',
    image: imgCourseWaite,
    icon: 'tarot',
  },
  {
    id: 'thu',
    code: '課程-D',
    day: '每週四',
    dayColor: 'bg-[#58A497] text-white',
    title: '七脈輪與靈氣',
    teacher: '學長老師',
    time: '20:00 - 23:00',
    price: '包月四堂 2000元',
    priceNote: '平均每堂 500元',
    extraNote: '可單報靈氣團練（21:45-23:00 包月四堂1000元）',
    description: '聚焦於人體七大能量樞紐（脈輪）與臼井靈氣手位調和，每週進行脈輪掃描、能量調頻與互助療癒練習，幫助現代人在緊湊的職場與生活步調中重新接地、找回身心和諧。',
    highlights: ['七大脈輪失衡訊號辨識與能量掃描', '臼井靈氣手位療癒與氣場平衡練習', '下班後的能量歸零與深層放鬆靜心'],
    suitableFor: '高壓上班族、常感疲憊焦慮、或希望學習自我能量保健的現代人。',
    image: imgCourseReiki,
    icon: 'reiki',
  },
  {
    id: 'fri',
    code: '課程-E',
    day: '每週五',
    dayColor: 'bg-[#C27BA0] text-white',
    title: '托特塔羅循環班',
    teacher: '學長老師',
    time: '20:00 - 23:00',
    price: '包月四堂 2000元',
    priceNote: '平均每堂 500元',
    extraNote: '可單報托特塔羅團練（20:00-21:00 包月四堂1000元）',
    description: '由學長老師帶領深入托特塔羅的象徵體系，解密色彩心理、埃及神話、占星學與卡巴拉符號在牌面上的深層隱喻，培養直覺穿透力與高維度的洞察解讀視角。',
    highlights: ['托特牌獨特色彩心理與幾何構圖解讀', '大阿卡納與卡巴拉生命之樹的符號對應', '高層次直覺連結與直指核心的牌義探討'],
    suitableFor: '喜愛深層神祕學符號、欲挑戰高階塔羅系統或想拓寬解讀廣度的占卜愛好者。',
    image: imgCourseThoth,
    icon: 'thoth',
  },
  {
    id: 'sat',
    code: '課程-F',
    day: '每週六',
    dayColor: 'bg-[#E08D5B] text-white',
    title: '生命靈數循環班',
    teacher: '皮皮老師',
    time: '20:00 - 23:00',
    price: '包月四堂 2000元',
    priceNote: '平均每堂 500元',
    extraNote: '從靈數連線、流年到合盤對應，扎實建立解盤思維',
    description: '以輕鬆易懂且邏輯嚴謹的方式，引導學員拆解出生年月日的數字原力，掌握生命靈數九宮格連線的特質優勢，並深入探討個人流年節奏與人際合盤的相處契機。',
    highlights: ['1~9 主命數原型與天賦潛能解碼', '九宮格連線意義與空缺數補強策略', '流年數計算與人生十年大運趨勢洞察'],
    suitableFor: '想快速掌握實用人際讀心工具、發掘自身天賦潛能與流年趨勢的所有人。',
    image: imgCourseNumerology,
    icon: 'numerology',
  },
];

// 交流會資料
const meetupInfo = {
  code: '課程-G',
  title: '命理交流會',
  fee: '300元 / 人',
  topics: ['占星', '八字', '紫微斗數', '多元命理系統研討'],
  sessions: [
    { date: '9/05（六）', time: '15:00 - 18:00' },
    { date: '9/20（日）', time: '15:00 - 18:00' },
    { date: '9/26（六）', time: '15:00 - 18:00' },
  ],
  description: '占星、八字、紫微斗數等命理系統，都歡迎一起來交流！不論是初學者還是執業老師，在溫暖無壓力的空間裡，互相切磋盤面、交流實務心得。',
  image: imgMeetup,
};

interface WorkshopSchedule {
  day: string;
  topic: string;
}

interface Workshop {
  id: string;
  code: string;
  title: string;
  subtitle: string;
  teacher: string;
  duration: string;
  fee: string;
  feeNote?: string;
  description: string;
  schedule?: WorkshopSchedule[];
  image: string;
  badge: string;
  icon: string;
}

// 主題體驗課程資料
const workshops: Workshop[] = [
  {
    id: 'meihua',
    code: '課程-H',
    title: '塏易學 梅花易數',
    subtitle: '最適合現代人的決策工具',
    teacher: '仲塏老師',
    duration: '12小時精華',
    fee: 'NT$15,000元 / 人',
    description: '採用客觀系統與模型，運用邏輯思維，清晰分析人生選項中的優劣勢。擺脫模糊猜測，以易理象數為指引，在重大人生節點做出精準決策。',
    image: imgWorkshopMeihua,
    badge: '專業研修',
    icon: 'meihua',
  },
  {
    id: 'bazi',
    code: '課程-I',
    title: '八字體驗',
    subtitle: '讀懂本命五行密碼・開啟自我生命覺察',
    teacher: '高楷博老師',
    duration: '10/24（六）14:00 - 18:00',
    fee: 'NT$1,000元 / 人',
    feeNote: '4 小時扎實精華體驗與個人盤面初探',
    description: '透過生辰八字的天干地支與五行能量，帶領學員初步認識個人先天命盤結構、五行喜忌與性格特質，從古老東方命理智慧中找到安頓身心與自我理解的清晰視角。',
    image: imgWorkshopBazi,
    badge: '命理體驗',
    icon: 'bazi',
  },
  {
    id: 'ziwei',
    code: '課程-J',
    title: '紫微斗數工作坊',
    subtitle: '兩日深度研修・解碼命盤十四主星',
    teacher: '阿福老師',
    duration: '11/8（日）、11/15（日）14:00 - 17:00',
    fee: '一堂 600元 · 兩堂 1,200元 / 人',
    feeNote: '兩天具備不同主題，可自由選擇單堂報名（600元）或兩堂合報（1,200元）',
    description: '深入淺出解讀紫微斗數命盤，探索十二宮位與星曜互動玄機。兩日分別規劃不同深度主題，從認識本命格局到洞察人際互動與吉凶契機，全面掌握東方帝王之學的解析邏輯。',
    schedule: [
      {
        day: '11/08（日）Day 1',
        topic: '第一天主題（主題即將公佈）',
      },
      {
        day: '11/15（日）Day 2',
        topic: '第二天主題（主題即將公佈）',
      },
    ],
    image: imgWorkshopZiwei,
    badge: '兩日專修',
    icon: 'ziwei',
  },
];
---

<Layout
  title="活動與課程 — 星靈織語 Starwoven"
  description="一起學習，一起交流，一起成長。只要你對身心靈命理有熱忱，歡迎加入星靈織語的固定循環班、命理交流會與特色主題體驗工作坊。"
  theme="auto"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    
    <!-- 頁頭 Header：還原 Canva 原始手繪溫暖意象 -->
    <header class="text-center max-w-3xl mx-auto mb-16 sm:mb-24 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-medium tracking-wider bg-[#80A9D4]/15 text-[#2E2A4F] dark:bg-white/10 dark:text-[#8FB8E8] transition-colors">
        ✦ 星靈織語共學空間 ✦
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wider transition-colors">
        課程與活動
      </h1>
      <p class="text-lg sm:text-xl text-[#3A3A3A]/85 dark:text-white/85 font-light leading-relaxed tracking-wide transition-colors">
        一起學習，一起交流，一起成長。<br class="hidden sm:inline" />
        只要你對身心靈命理有熱忱，歡迎加入星靈織語的共學旅程。
      </p>
      <div class="w-20 h-1.5 bg-[#80A9D4] mx-auto rounded-full mt-3 opacity-80"></div>
    </header>

    <!-- ======================================================== -->
    <!-- 【專區 1】：固定課程 (Recurring Classes)                 -->
    <!-- ======================================================== -->
    <section class="mb-20 sm:mb-28">
      
      <!-- 專區標題列 -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-12 border-b border-[#80A9D4]/20 dark:border-white/10 pb-5">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="w-3 h-7 bg-[#80A9D4] rounded-full inline-block"></span>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wider transition-colors">
              固定循環課程
            </h2>
          </div>
          <p class="text-sm sm:text-base text-[#3A3A3A]/75 dark:text-white/70 mt-2 font-light tracking-wide transition-colors">
            每週一至週六常態循環開課・包月制深度陪伴・可單獨報名團練
          </p>
        </div>

        <div class="text-xs sm:text-sm text-[#80A9D4] dark:text-[#8FB8E8] font-semibold bg-[#80A9D4]/10 dark:bg-white/10 px-4 py-2 rounded-full self-start sm:self-auto">
          每期 4 堂 1,200 ~ 2,000 元（平均 300 ~ 500 元 / 堂）
        </div>
      </div>

      <!-- 6 大固定課程列表 (圖片常態外顯 + 細節介紹手風琴收折) -->
      <div class="flex flex-col gap-6 sm:gap-8" id="courses-accordion-container">
        {recurringCourses.map((c, index) => (
          <div class="group bg-white/85 dark:bg-white/10 backdrop-blur-md rounded-3xl p-5 sm:p-7 border border-[#80A9D4]/25 dark:border-white/15 shadow-xs hover:shadow-lg transition-all duration-300">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 items-start">
              
              <!-- 左側：圖片插槽（【常態外顯】，隨時可見） (佔 5 欄) -->
              <div class="md:col-span-5 relative w-full aspect-16/10 rounded-2xl overflow-hidden bg-[#EAF3F8]/70 dark:bg-white/5 border border-[#80A9D4]/20 dark:border-white/10 shadow-inner">
                <!-- 星期色彩標籤（左上角浮動膠囊） -->
                <span class:list={['absolute top-3 left-3 z-10 text-xs sm:text-sm font-bold px-3.5 py-1 rounded-full shadow-md tracking-wider', c.dayColor]}>
                  {c.day}
                </span>

                <!-- 圖片 / 精神象徵 SVG 佔位符 -->
                {c.image ? (
                  <img
                    src={c.image}
                    alt={`${c.title} 現場照片`}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full border-2 border-dashed border-[#80A9D4]/40 dark:border-white/20 flex flex-col items-center justify-center p-4 text-center group-hover:border-[#2E2A4F]/40 dark:group-hover:border-white/40 transition-colors">
                    {c.icon === 'akashic' && (
                      <svg class="w-12 h-12 text-[#80A9D4] dark:text-[#8FB8E8] mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                      </svg>
                    )}
                    {c.icon === 'astrology' && (
                      <svg class="w-12 h-12 text-[#9880B8] dark:text-[#8FB8E8] mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="9" />
                        <ellipse cx="12" cy="12" rx="9" ry="4" transform="rotate(-30 12 12)" />
                      </svg>
                    )}
                    {c.icon === 'tarot' && (
                      <svg class="w-12 h-12 text-[#5B8EA6] dark:text-[#8FB8E8] mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="5" y="3" width="14" height="18" rx="2" />
                        <circle cx="12" cy="12" r="2" />
                      </svg>
                    )}
                    {c.icon === 'reiki' && (
                      <svg class="w-12 h-12 text-[#58A497] dark:text-[#8FB8E8] mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M7 11c0-2.5 2-4.5 5-4.5s5 2 5 4.5" />
                        <path d="M5 14c0 3 3.5 6 7 6s7-3 7-6" />
                      </svg>
                    )}
                    {c.icon === 'thoth' && (
                      <svg class="w-12 h-12 text-[#C27BA0] dark:text-[#8FB8E8] mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <polygon points="12,2 22,8.5 22,15.5 12,22 2,15.5 2,8.5" />
                      </svg>
                    )}
                    {c.icon === 'numerology' && (
                      <svg class="w-12 h-12 text-[#E08D5B] dark:text-[#8FB8E8] mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <polygon points="12,2 22,19 2,19" />
                        <circle cx="12" cy="12" r="2" />
                      </svg>
                    )}
                    <span class="text-xs font-semibold text-[#2E2A4F]/70 dark:text-white/70 tracking-wider">
                      {c.code}・活動現場照片
                    </span>
                  </div>
                )}
              </div>

              <!-- 右側：課程基本資訊（常態外顯） + 細節介紹收折（手風琴） (佔 7 欄) -->
              <div class="md:col-span-7 flex flex-col justify-between space-y-4">
                
                <!-- 標題、講師、時間與價格基本列（隨時可見） -->
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-3 mb-2.5">
                    <h3 class="text-2xl sm:text-3xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wide transition-colors">
                      {c.title}
                    </h3>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#80A9D4]/15 dark:bg-white/10 text-sm font-semibold text-[#80A9D4] dark:text-[#8FB8E8]">
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                        <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" />
                      </svg>
                      {c.teacher}
                    </span>
                  </div>

                  <!-- 時段與費用外顯小摘要 -->
                  <div class="flex flex-wrap items-center justify-between gap-2 text-sm sm:text-base text-[#3A3A3A]/80 dark:text-white/80 font-medium mb-3 transition-colors">
                    <div class="flex items-center gap-2">
