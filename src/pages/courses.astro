  <style>
    /* 手風琴展開平滑微動畫 */
    details.course-accordion[open] > .course-content {
      animation: accordionSlideDown 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes accordionSlideDown {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script is:inline>
    // 手風琴互斥模式（Accordion Mode）相容性保證腳本
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('courses-accordion-container');
      if (!container) return;

      const accordions = container.querySelectorAll('details.course-accordion');
      accordions.forEach((acc) => {
        acc.addEventListener('toggle', () => {
          if (acc.open) {
            accordions.forEach((other) => {
              if (other !== acc && other.open) {
                other.open = false;
              }
            });
          }
        });
      });
    });
  </script>
