                    </div>

                    <!-- 評語內容 -->
                    <p class="text-sm sm:text-base text-[#3A3A3A] dark:text-white/90 font-huninn tracking-wide leading-relaxed transition-colors">
                      「{review.comment}」
                    </p>
                  </div>

                  <div class="mt-5 pt-3 border-t border-gray-100 dark:border-white/10 flex items-center justify-between text-xs text-gray-400 dark:text-white/50 font-huninn transition-colors">
                    <span>{review.source || (review.tag ? '課堂真實回饋' : '真實好評推薦')}</span>
                    <span class="text-[#80A9D4] dark:text-[#8FB8E8] font-medium">心靈成長見證</span>
                  </div>

                </div>
              ))}
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ======================================================== -->
  <!-- 4. 命理師介紹 (精準還原截圖 圓框人像卡片)                    -->
  <!-- ======================================================== -->
  <section class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-[#DFECF3]/90 dark:bg-[#18152e] border-t border-[#80A9D4]/20 dark:border-white/10 overflow-hidden transition-colors duration-300">
    <!-- 星空背景微光延伸與星塵光斑 -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#D8E6F0] via-[#E2EDF5] to-[#D3E3EE] dark:from-[#17142b] dark:via-[#201b3a] dark:to-[#151226] -z-20 transition-all duration-300"></div>
    <div class="absolute inset-0 pointer-events-none -z-10">
      <span class="absolute top-[20%] left-[8%] w-2 h-2 bg-[#FCE794]/40 rounded-full blur-[0.5px]"></span>
      <span class="absolute top-[45%] right-[12%] w-2.5 h-2.5 bg-white/40 rounded-full blur-[1px]"></span>
      <span class="absolute bottom-[25%] left-[25%] w-1.5 h-1.5 bg-[#8FB8E8]/50 rounded-full blur-[0.5px]"></span>
      <span class="absolute top-[75%] right-[28%] w-2 h-2 bg-white/30 rounded-full blur-[1px]"></span>
    </div>

    <div class="max-w-7xl mx-auto space-y-16">
      
      <!-- 標題與「查看星靈織語成員」導航按鈕 -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-wider text-[#2E2A4F] dark:text-white font-huninn transition-colors">
          命理師介紹
        </h2>
        <a
          href="/about"
          class="inline-flex items-center gap-2.5 self-start sm:self-auto bg-[#DFECF3] hover:bg-white text-[#2E2A4F] px-6 py-2.5 rounded-full font-huninn font-bold tracking-wider text-base sm:text-lg shadow-sm hover:shadow-md transition-all duration-300 group"
        >
          <span>查看星靈織語成員</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </a>
      </div>

      <!-- 三位命理師 圓框頭像卡片 Grid（桌機三欄、手機單欄） -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 sm:gap-10 lg:gap-14">
        {featuredReaders.map((reader) => (
          <div class="group flex flex-col items-center text-center">
            
            <!-- 圓框照片容器（完美正圓、維持等比 object-cover 絕不變形） -->
            <div class="relative w-52 h-52 sm:w-60 sm:h-60 lg:w-68 lg:h-68 rounded-full overflow-hidden shadow-2xl border-2 border-white/20 bg-[#2b254a] flex items-center justify-center group-hover:border-white/40 group-hover:shadow-[0_0_30px_rgba(143,184,232,0.3)] transition-all duration-500">
              {reader.image ? (
                <img
                  src={reader.image}
                  alt={reader.name}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <!-- 佔位框：高雅的人像剪影佔位圖示 -->
                <div class="w-full h-full p-4 flex flex-col items-center justify-center text-center border-2 border-dashed border-white/30 rounded-full bg-white/5 group-hover:bg-white/10 transition-colors">
                  <svg class="w-14 h-14 text-white/40 mb-2 mt-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                  </svg>
                  <span class="text-xs font-semibold text-[#2E2A4F] bg-[#DFECF3] px-2.5 py-0.5 rounded-full shadow-xs mb-1">
                    {reader.code}
                  </span>
                  <p class="text-[11px] text-white/70 leading-tight">
                    {reader.name} 現場照片<br />
                    <span class="text-[10px] text-white/50">(待提供真實照片)</span>
                  </p>
                </div>
              )}
            </div>

            <!-- 命理師姓名 -->
            <h3 class="text-2xl sm:text-3xl font-bold text-[#2E2A4F] dark:text-white font-huninn tracking-wider mt-8 mb-4 transition-colors">
              {reader.name}
            </h3>

            <!-- 專長與身分條列 -->
            <ul class="space-y-2 text-base sm:text-xl text-[#3A3A3A]/85 dark:text-white/85 font-huninn tracking-wider leading-relaxed transition-colors">
              {reader.skills.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>

          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>

<style>
  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .testimonial-marquee-wrapper {
    display: flex;
    width: max-content;
  }

  .testimonial-track {
    display: flex;
    animation: marquee-scroll 38s linear infinite;
  }

  .testimonial-marquee-wrapper:hover .testimonial-track {
    animation-play-state: paused;
  }
</style>

