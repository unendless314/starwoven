---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';

// ==========================================
// 圖片素材路徑配置（ComfyUI 生圖或取得真圖後填入此處）
// 例如：const imgTarotWorld = '/assets/home_a_tarot_world_v1.png';
// 若為空字串，將自動顯示結構佔位框（Placeholder）
// ==========================================

// 【1. Hero 視覺區】
const imgTarotWorld = '';       // 首頁-A：右側直式「塔羅世界牌」
const imgZodiacWheel = '';      // 首頁-B：左下透視「十二星座星盤輪盤」
const imgHeroBg = '';           // 首頁-P：底層星空圖（選填，留空時由 CSS 漸層與光斑渲染）

// 【2. 四大核心服務卡片區】
const imgServiceAstrology = ''; // 首頁-C：命理諮詢「行星與星環」
const imgCourseBook = '';       // 首頁-D：課程學習「筆記本與筆」
const imgEventCommunity = '';   // 首頁-E：實體活動「三人社群夥伴剪影」
const imgReikiTune = '';        // 首頁-F：靈氣調頻「雙手療癒與能量光芒」

// 【3. 固定循環課程現場照片（待業主提供真圖）】
const imgCourseMon = '';        // 首頁-G：每週一 阿卡西紀錄與光的課程活動照
const imgCourseTue = '';        // 首頁-H：每週二 占星循環班活動照
const imgCourseWed = '';        // 首頁-I：每週三 偉特塔羅團練活動照
const imgCourseThu = '';        // 首頁-J：每週四 七脈輪與靈氣團練活動照
const imgCourseFri = '';        // 首頁-K：每週五 托特塔羅循環班活動照
const imgCourseSat = '';        // 首頁-L：每週六 生命靈數活動照

// 【4. 學員與 Google 評價輪播資料（tag 為選填，Google 評論可直接從缺）】
interface ReviewItem {
  id: string;
  comment: string;
  tag?: string;             // 選填：課程標籤（如：偉特塔羅循環班，若為 Google 評論可留空或從缺）
  source?: string;          // 選填：來源標示（例如：'Google 商家評論' 或 '課堂學員'）
  avatarBg?: string;        // 選填：頭像背景色（若未填則自動分配預設柔和漸層）
  avatarText?: string;      // 選填：頭像首字（若未填則自動取 ID 第一個字元）
  rating?: number;          // 選填：星等（預設 5 星）
}

const studentReviews: ReviewItem[] = [
  {
    id: '林熙玲',
    source: 'Google 商家好評',
    avatarBg: 'bg-gradient-to-br from-[#11998E] to-[#38EF7D]',
    avatarText: '林',
    rating: 5,
    comment: '很溫馨的命理身心靈教室！！課程很喜歡~大家也都很溫暖~空間很舒適！有一種讓人不想回家的吸引力~每次上完課還能聊個好幾小時捨不得回家🤣🤣',
  },
  {
    id: 'ZhongKai',
    source: 'Google 商家好評',
    avatarBg: 'bg-gradient-to-br from-[#4A90E2] to-[#144A75]',
    avatarText: 'Z',
    rating: 5,
    comment: '非常棒的命理身心靈空間，授課設備完善、店家溝通無礙，不論是交流或者開班授課，都是高雄地區的好選擇。',
  },
  {
    id: '夏瞳（嶽燁嵐）',
    tag: '塔羅團練',
    source: 'Google 商家好評',
    avatarBg: 'bg-gradient-to-br from-[#8A2387] to-[#E94057]',
    avatarText: '夏',
    rating: 5,
    comment: '有特別的塔羅團練！很活的學習與互相成長方式，很讚，很喜歡~',
  },
  {
    id: 'Yuyu Chen',
    source: 'Google 商家好評',
    avatarBg: 'bg-gradient-to-br from-[#E94E77] to-[#C02942]',
    avatarText: 'Y',
    rating: 5,
    comment: '總類豐富，想要東西方命理都有，環境優良，成員好相處💯❤️',
  },
  {
    id: '洣白',
    source: 'Google 商家好評',
    avatarBg: 'bg-gradient-to-br from-[#00B4DB] to-[#0083B0]',
    avatarText: '洣',
    rating: 5,
    comment: '很舒適的空間，內部人員相處也很不錯👍🏻',
  },
  {
    id: '黃憶雯',
    source: 'Google 商家好評',
    avatarBg: 'bg-gradient-to-br from-[#F7971E] to-[#FFD200]',
    avatarText: '黃',
    rating: 5,
    comment: '身心靈聚會的好地方！✨',
  },
];



// 課程資料陣列（資料驅動，方便未來隨時擴充與修改課表）

const recurringCourses = [
  {
    id: 'mon',
    day: '每週一',
    title: '阿卡西紀錄\n與光的課程',
    teacher: '古古老師',
    time: '20:00-23:00',
    price: '包月四堂2000元',
    image: imgCourseMon,
    code: '首頁-G',
  },
  {
    id: 'tue',
    day: '每週二',
    title: '占星循環班',
    teacher: '皮皮老師',
    time: '20:00-23:00',
    price: '包月四堂2000元',
    image: imgCourseTue,
    code: '首頁-H',
  },
  {
    id: 'wed',
    day: '每週三',
    title: '偉特塔羅\n團練',
    teacher: '以恩老師',
    time: '20:00-21:30',
    price: '包月四堂1200元',
    image: imgCourseWed,
    code: '首頁-I',
  },
  {
    id: 'thu',
    day: '每週四',
    title: '七脈輪與\n靈氣團練',
    teacher: '曉宇老師',
    time: '20:00-23:00',
    price: '包月四堂2000元',
    image: imgCourseThu,
    code: '首頁-J',
  },
  {
    id: 'fri',
    day: '每週五',
    title: '托特塔羅\n循環班',
    teacher: '曉宇老師',
    time: '20:00-23:00',
    price: '包月四堂2000元',
    image: imgCourseFri,
    code: '首頁-K',
  },
  {
    id: 'sat',
    day: '每週六',
    title: '生命靈數',
    teacher: '皮皮老師',
    time: '20:00-23:00',
    price: '包月四堂2000元',
    image: imgCourseSat,
    code: '首頁-L',
  },
];

// 【5. 命理師介紹圓框頭像（待提供現場真實照片）】
const imgReaderYiEn = '';        // 首頁-M：以恩 圓形現場照片
const imgReaderPiPi = '';        // 首頁-N：皮皮 圓形現場照片
const imgReaderDaXin = '';       // 首頁-O：達心 圓形現場照片

const featuredReaders = [
  {
    name: '以恩',
    skills: [
      '塔羅占卜、占星解析',
      '塔羅占卜培訓',
      '星靈織語創辦人',
    ],
    image: imgReaderYiEn,
    code: '首頁-M',
  },
  {
    name: '皮皮',
    skills: [
      '占星教學、師資培訓',
      '占星解盤、生命靈數',
      '星靈織語創辦人',
    ],
    image: imgReaderPiPi,
    code: '首頁-N',
  },
  {
    name: '達心',
    skills: [
      '八字命理、塔羅占卜',
      '八字基礎教學',
      '駐點占卜',
    ],
    image: imgReaderDaXin,
    code: '首頁-O',
  },
];
---

<Layout
  title="星靈織語 Starwoven — 每一段相遇，都是一場心靈的編織"
  description="星靈織語提供命理與占卜服務，包含塔羅、占星、八字、靈氣調頻與阿卡西紀錄，陪伴你探索生命可能，找到心靈方向。"
  theme="auto"
>
  <!-- ======================================================== -->
  <!-- 1. Hero Section (主視覺區塊)                             -->
  <!-- ======================================================== -->
  <section
    class="relative min-h-[90vh] flex items-center justify-center overflow-hidden px-4 sm:px-6 lg:px-12 py-16 sm:py-24 transition-colors duration-300"
    style={imgHeroBg ? `background-image: url('${imgHeroBg}'); background-size: cover; background-position: center;` : undefined}
  >
    <!-- 背景層：深靛藍漸層與星塵光斑粒子（深色） / 柔和水彩藍（淺色） -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#DFECF3] via-[#EAF3F8] to-[#D5E5F0] dark:from-[#241f42] dark:via-[#2E2A4F] dark:to-[#1d1a36] -z-20 transition-all duration-300"></div>

    <!-- 柔和星光與星塵光斑 (Bokeh / Dust) -->
    <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-[#8FB8E8]/20 dark:bg-[#8FB8E8]/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/3 right-1/4 w-[28rem] h-[28rem] bg-[#80A9D4]/20 dark:bg-[#a29bfe]/10 rounded-full blur-3xl"></div>

      <!-- 散落的光斑微粒 -->
      <span class="absolute top-[12%] left-[18%] w-1.5 h-1.5 bg-[#8FB8E8] dark:bg-white/70 rounded-full blur-[0.5px] animate-pulse"></span>
      <span class="absolute top-[28%] left-[45%] w-2 h-2 bg-[#80A9D4]/60 dark:bg-white/60 rounded-full blur-[1px]"></span>
      <span class="absolute top-[15%] right-[25%] w-1.5 h-1.5 bg-[#FCE794] rounded-full blur-[0.5px]"></span>
      <span class="absolute top-[42%] right-[15%] w-2.5 h-2.5 bg-[#8FB8E8]/40 dark:bg-white/40 rounded-full blur-[1.5px]"></span>
      <span class="absolute bottom-[30%] left-[22%] w-2 h-2 bg-[#8FB8E8]/50 dark:bg-white/50 rounded-full blur-[1px]"></span>
      <span class="absolute bottom-[18%] left-[40%] w-3 h-3 bg-[#80A9D4]/30 dark:bg-white/30 rounded-full blur-[2px]"></span>
      <span class="absolute bottom-[25%] right-[32%] w-1.5 h-1.5 bg-[#8FB8E8] rounded-full blur-[0.5px]"></span>
      <span class="absolute top-[65%] right-[8%] w-2 h-2 bg-[#80A9D4]/50 dark:bg-white/60 rounded-full blur-[1px]"></span>
    </div>

    <!-- Hero 主容器：左右兩欄佈局（桌機左右並排、手機垂直排列） -->
    <div class="max-w-7xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center z-10">
      
      <!-- 左側欄位：文字位置 + 圖片位置 B (十二星座星盤) -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-12 text-left">
        
        <!-- 主要文字區塊 -->
        <div class="space-y-6 max-w-2xl">
          <h1 class="text-3xl sm:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-wide sm:tracking-wider text-[#2E2A4F] dark:text-white leading-[1.25] font-huninn transition-colors">
            每一段相遇，<br />
            都是一場心靈的編織。
          </h1>

          <p class="text-base sm:text-lg lg:text-xl text-[#3A3A3A]/85 dark:text-white/85 font-light leading-relaxed tracking-wide pt-1 transition-colors">
            以命理與占卜陪伴每一位來到這裡的人，<br class="hidden sm:inline" />
            透過交流與練習，陪你從理解走向實踐。
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <CTAButton variant="hero" text="預約諮詢" />
            <a
              href="/services"
              class="inline-flex items-center justify-center px-7 py-3 rounded-full border border-[#2E2A4F]/30 text-[#2E2A4F] hover:bg-[#2E2A4F]/10 dark:border-white/30 dark:text-white dark:hover:bg-white/10 transition-all duration-300 text-base tracking-wider backdrop-blur-xs"
            >
              探索命理服務
            </a>
          </div>
        </div>

        <!-- 圖片位置 B：十二星座透視星盤輪盤 -->
        <div class="pt-4 sm:pt-6">
          {imgZodiacWheel ? (
            <div class="relative max-w-[420px] transition-transform hover:scale-105 duration-500">
              <img
                src={imgZodiacWheel}
                alt="十二星座星盤輪盤"
                class="w-full h-auto object-contain drop-shadow-[0_10px_35px_rgba(0,0,0,0.5)] -rotate-12"
              />
            </div>
          ) : (
            <div class="relative w-full max-w-[380px] sm:max-w-[420px] aspect-[16/10] rounded-3xl border-2 border-dashed border-[#8FB8E8]/40 bg-white/5 backdrop-blur-xs p-6 flex flex-col items-center justify-center text-center shadow-lg transition-all hover:border-[#8FB8E8]/70 group">
              <div class="w-20 h-20 rounded-full border border-[#8FB8E8]/30 flex items-center justify-center mb-3 group-hover:rotate-45 transition-transform duration-700">
                <svg class="w-10 h-10 text-[#8FB8E8]/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  <path d="M2 12h20" />
                </svg>
              </div>
              <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold tracking-wider bg-[#8FB8E8]/20 text-[#8FB8E8] border border-[#8FB8E8]/30 mb-2">
                首頁-B
              </span>
              <h3 class="text-sm sm:text-base font-medium text-white tracking-wider">
                十二星座透視星盤輪盤
              </h3>
              <p class="text-xs text-white/60 mt-1">
                建議規格：白線向量去背 PNG / SVG（微透視角度）
              </p>
            </div>
          )}
        </div>

      </div>

      <!-- 右側欄位：圖片位置 A (塔羅牌世界牌主視覺) -->
      <div class="lg:col-span-5 flex justify-center items-center">
        {imgTarotWorld ? (
          <div class="relative w-full max-w-[460px] transition-transform hover:scale-102 duration-500">
            <img
              src={imgTarotWorld}
              alt="塔羅牌・世界牌 (The World)"
              class="w-full h-auto object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.6)]"
            />
          </div>
        ) : (
          <div class="relative w-full max-w-[360px] sm:max-w-[400px] aspect-[3/4] sm:aspect-[4/5] rounded-3xl border-2 border-dashed border-white/35 bg-white/5 backdrop-blur-xs p-8 flex flex-col items-center justify-center text-center shadow-[0_0_60px_rgba(143,184,232,0.12)] hover:border-white/60 transition-all group">
            <div class="w-32 h-44 rounded-[2.5rem] border border-[#8FB8E8]/40 flex flex-col items-center justify-center mb-6 relative group-hover:scale-105 transition-transform duration-500">
              <span class="absolute -top-2 -left-2 w-3 h-3 rounded-full bg-[#8FB8E8]/40"></span>
              <span class="absolute -top-2 -right-2 w-3 h-3 rounded-full bg-[#8FB8E8]/40"></span>
              <span class="absolute -bottom-2 -left-2 w-3 h-3 rounded-full bg-[#8FB8E8]/40"></span>
              <span class="absolute -bottom-2 -right-2 w-3 h-3 rounded-full bg-[#8FB8E8]/40"></span>

              <svg class="w-14 h-14 text-[#8FB8E8]/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z" />
              </svg>
            </div>

            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider bg-[#FCE794]/20 text-[#FCE794] border border-[#FCE794]/30 mb-2">
              首頁-A（主視覺）
            </span>
            <h2 class="text-base sm:text-lg font-medium text-white tracking-widest">
              塔羅牌・世界牌 (The World)
            </h2>
            <p class="text-xs text-white/65 mt-1.5 leading-relaxed max-w-[260px]">
              手繪白線圖騰、花環舞者與四大元素獸<br />
              建議規格：垂直比例去背 PNG / SVG
            </p>
          </div>
        )}
      </div>

    </div>
  </section>

  <!-- ======================================================== -->
  <!-- 2. 四大核心服務探索區 (精準還原截圖四張卡片)              -->
  <!-- ======================================================== -->
  <section class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-[#EAF3F8] dark:bg-[#1d1a36] border-t border-[#80A9D4]/20 dark:border-white/10 overflow-hidden transition-colors duration-300">
    <!-- 星空光斑延伸 -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#DFECF3] via-[#EAF3F8] to-[#DFECF3] dark:from-[#1d1a36] dark:via-[#252140] dark:to-[#1c1834] -z-20 transition-all duration-300"></div>
    <div class="absolute inset-0 pointer-events-none -z-10">
      <span class="absolute top-[20%] left-[10%] w-2 h-2 bg-white/40 rounded-full blur-[1px]"></span>
      <span class="absolute top-[45%] left-[85%] w-1.5 h-1.5 bg-[#FCE794]/60 rounded-full blur-[0.5px]"></span>
      <span class="absolute bottom-[25%] left-[30%] w-2.5 h-2.5 bg-white/30 rounded-full blur-[1.5px]"></span>
      <span class="absolute bottom-[15%] right-[20%] w-2 h-2 bg-[#8FB8E8]/50 rounded-full blur-[1px]"></span>
    </div>

    <div class="max-w-7xl mx-auto space-y-16">
      
      <!-- 標題與副標 -->
      <div class="text-center space-y-4 max-w-4xl mx-auto">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-wider text-[#2E2A4F] dark:text-white font-huninn leading-tight transition-colors">
          星靈織語，陪你一起探索生命的可能
        </h2>
        <p class="text-base sm:text-lg lg:text-xl text-[#3A3A3A]/80 dark:text-white/80 font-light leading-relaxed tracking-wide transition-colors">
          每一場身心靈、命理活動，幫助你在迷惘時刻找到方向，在探索路上不再孤單。
        </p>
      </div>

      <!-- 四大核心服務卡片 Grid（桌機4欄、平板2欄、手機1欄） -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        
        <!-- 卡片 1: 命理諮詢 (首頁-C：行星與星環) -->
        <a
          href="/services"
          class="group block bg-[#EAF0F6] rounded-[2.5rem] p-8 sm:p-10 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 text-center border border-white/60"
        >
          <div class="h-28 flex items-center justify-center mb-6">
            {imgServiceAstrology ? (
              <img
                src={imgServiceAstrology}
                alt="命理諮詢 行星與星環插圖"
                class="max-h-24 w-auto object-contain mx-auto transition-transform duration-300 group-hover:scale-105"
              />
            ) : (
              <div class="w-full h-full rounded-2xl border-2 border-dashed border-[#8FB8E8]/60 bg-white/60 flex flex-col items-center justify-center p-2 group-hover:border-[#2E2A4F]/50 transition-colors">
                <svg class="w-10 h-10 text-[#2E2A4F]/70 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="6" />
                  <path d="M2.5 12c0-3 4-6 9.5-6s9.5 3 9.5 6-4 6-9.5 6-9.5-3-9.5-6z" transform="rotate(-20 12 12)" />
                </svg>
                <span class="text-[11px] font-semibold text-[#2E2A4F]/80 tracking-wider">
                  首頁-C：行星與星環
                </span>
              </div>
            )}
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold text-[#2E2A4F] mb-6 font-huninn tracking-wider">
            命理諮詢
          </h3>

          <ul class="space-y-3.5 text-lg sm:text-xl text-[#3A3A3A] font-huninn tracking-widest leading-relaxed">
            <li>塔羅占卜</li>
            <li>占星解析</li>
            <li>八字命理</li>
            <li>生命靈數</li>
          </ul>
        </a>

        <!-- 卡片 2: 課程學習 (首頁-D：筆記本與筆) -->
        <a
          href="/courses"
          class="group block bg-[#EAF0F6] rounded-[2.5rem] p-8 sm:p-10 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 text-center border border-white/60"
        >
