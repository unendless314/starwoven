---
import Layout from '../layouts/Layout.astro';
import { CARE_COPY } from '../lib/ai/shared/care';
import { DECK_ORDER, QUESTION_MAX_CHARS } from '../lib/astro-cards/config';
import { PAGE_META, PLACEHOLDER_NOTE, PRIVACY_NOTE, UI_TEXT } from '../lib/astro-cards/copy';
import { DECK_MARKS, DECK_NAMES } from '../lib/astro-cards/decks';

// ==========================================
// 線上占星抽卡（AI 解讀）MVP — DEC-080，規格 demo_docs/astro_cards_plan.md
// 靜態頁（prerender）；互動邏輯在 src/scripts/astro-cards.ts（頁面層級 script 引入）。
// Demo 期間不加入主導航、加 noindex，以直接網址供業主評估。
// 狀態區塊：setup（提問）→ pick（三疊依序選牌）→ result（翻牌＋解讀）／care／error
// 樣式 class 前綴 ac-（避免與 Astro 自動產生之 astro-* class 混淆）
// ==========================================
const LINE_URL = 'https://line.me/R/ti/p/@347fucvj?ts=07031038&oat_content=url';
---

<Layout
  title={PAGE_META.title}
  description={PAGE_META.description}
  theme="auto"
  noindex
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24" data-ac-root>

    <!-- 頁頭 Header -->
    <header class="text-center max-w-3xl mx-auto mb-10 sm:mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8FB8E8]/20 dark:bg-[#8FB8E8]/15 border border-[#80A9D4]/40 dark:border-[#8FB8E8]/30 text-[#2E2A4F]/85 dark:text-[#8FB8E8] text-xs sm:text-sm font-huninn tracking-widest transition-colors">
        <span>✦</span>
        <span>{UI_TEXT.badge}</span>
        <span>✦</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wider transition-colors">
        {UI_TEXT.heading}
      </h1>
      <p class="text-lg sm:text-xl text-[#3A3A3A]/85 dark:text-white/85 font-light leading-relaxed tracking-wide transition-colors">
        {UI_TEXT.intro[0]}<br class="hidden sm:inline" />
        {UI_TEXT.intro[1]}
      </p>
      <div class="w-20 h-1.5 bg-[#8FB8E8] mx-auto rounded-full mt-3 opacity-80"></div>
    </header>

    <!-- ① 輸入問題 -->
    <section data-step="setup" aria-labelledby="ac-setup-title" class="ac-panel">
      <h2 id="ac-setup-title" class="sr-only">{UI_TEXT.setupHeading}</h2>
      <form id="ac-form" class="space-y-8" novalidate>
        <div>
          <label for="ac-question" class="block text-lg sm:text-xl font-bold font-huninn tracking-wider text-[#2E2A4F] dark:text-white mb-4">
            {UI_TEXT.questionLabel}
          </label>
          <textarea
            id="ac-question"
            name="question"
            rows="3"
            placeholder={UI_TEXT.questionPlaceholder}
            aria-describedby="ac-question-count ac-privacy"
            class="w-full rounded-2xl border px-4 py-3 text-base leading-relaxed resize-none transition-colors bg-white/95 dark:bg-[#231f40]/95 border-gray-200/80 dark:border-white/20 text-[#3A3A3A] dark:text-white placeholder:text-[#3A3A3A]/40 dark:placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-[#80A9D4] dark:focus:ring-[#8FB8E8]"
          ></textarea>
          <div class="flex flex-col-reverse sm:flex-row sm:items-start justify-between gap-2 mt-2 text-xs sm:text-sm">
            <p id="ac-privacy" class="text-[#3A3A3A]/65 dark:text-white/60 leading-relaxed">🔒 {PRIVACY_NOTE}</p>
            <p id="ac-question-count" class="shrink-0 text-[#3A3A3A]/60 dark:text-white/55 tabular-nums" aria-live="polite">
              <span data-question-count>0</span> / {QUESTION_MAX_CHARS}
            </p>
          </div>
        </div>

        <div class="text-center">
          <button
            type="submit"
            class="inline-flex items-center gap-2 bg-[#80A9D4] hover:bg-[#6b97c4] text-white px-10 py-3.5 rounded-full font-huninn font-bold tracking-widest text-lg shadow-lg hover:shadow-xl transition-all duration-200 active:scale-95 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span>✦</span>
            <span>{UI_TEXT.startButton}</span>
          </button>
        </div>
      </form>
    </section>

    <!-- ② 三疊依序選牌（儀式性互動，不決定實際牌面）：上方固定三個牌槽，一次展開一疊 -->
    <section data-step="pick" aria-labelledby="ac-pick-status" class="ac-panel" hidden>
      <ol class="flex justify-center gap-4 sm:gap-8 mb-8" aria-label={UI_TEXT.slotsLabel}>
        {DECK_ORDER.map((deck) => (
          <li class="ac-slot flex flex-col items-center gap-2" data-slot={deck}>
            <span class="ac-slot-box" aria-hidden="true">
              <span class="ac-slot-card ac-card-back" data-mark={DECK_MARKS[deck]}></span>
            </span>
            <span class="ac-slot-label text-sm sm:text-base font-huninn tracking-wider">{DECK_NAMES[deck]}</span>
          </li>
        ))}
      </ol>
      <p id="ac-pick-status" class="text-center text-lg sm:text-xl font-huninn tracking-wider text-[#2E2A4F] dark:text-white min-h-[1.75em]" aria-live="polite"></p>
      <div class="ac-fan mt-4" data-fan role="group"></div>
      <div class="text-center mt-8" data-waiting hidden>
        <span class="ac-orbit" aria-hidden="true"><span></span><span></span><span></span></span>
      </div>
    </section>

    <!-- ③ 翻牌＋解讀 -->
    <section data-step="result" aria-labelledby="ac-result-title" class="ac-panel" hidden>
      <h2 id="ac-result-title" class="text-center text-2xl sm:text-3xl font-bold font-huninn tracking-wider text-[#2E2A4F] dark:text-white mb-8">
        {UI_TEXT.badge}
      </h2>
      <div class="flex justify-center gap-3 sm:gap-6 mb-10" data-result-cards></div>
      <div class="space-y-5" data-reading aria-live="polite"></div>
    </section>

    <!-- ③' 安全關懷（自傷相關提問：不抽牌、不呼叫 AI） -->
    <section data-step="care" aria-labelledby="ac-care-title" class="ac-panel" hidden>
      <div class="max-w-xl mx-auto rounded-3xl border p-6 sm:p-8 bg-white/95 dark:bg-[#231f40]/95 border-[#80A9D4]/40 dark:border-white/20 shadow-lg text-center space-y-5">
        <p class="text-4xl" aria-hidden="true">🤍</p>
        <h2 id="ac-care-title" class="text-xl sm:text-2xl font-bold font-huninn tracking-wider text-[#2E2A4F] dark:text-white">{CARE_COPY.title}</h2>
        <p class="text-base leading-relaxed text-[#3A3A3A]/85 dark:text-white/85">{CARE_COPY.body}</p>
        <ul class="space-y-2.5">
          {CARE_COPY.hotlines.map((h) => (
            <li>
              <a href={`tel:${h.number}`} class="flex items-center justify-between gap-3 rounded-2xl px-5 py-3 bg-[#EAF3F8] dark:bg-white/10 text-[#2E2A4F] dark:text-white hover:bg-[#DFECF3] dark:hover:bg-white/15 transition-colors">
                <span class="font-huninn tracking-wider">{h.name}{h.note && <span class="text-sm opacity-70">（{h.note}）</span>}</span>
                <span class="text-xl font-bold tabular-nums tracking-widest">{h.number}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a href={LINE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#06C755] hover:bg-[#05b04c] text-white px-7 py-3 rounded-full font-huninn font-bold tracking-wider shadow-sm hover:shadow-md transition-all active:scale-95">
            {CARE_COPY.lineCta}
          </a>
          <button type="button" data-action="again" class="ac-secondary-btn">{UI_TEXT.again}</button>
        </div>
      </div>
    </section>

    <!-- 錯誤 -->
    <section data-step="error" aria-labelledby="ac-error-message" class="ac-panel" hidden>
      <div class="text-center py-10 sm:py-14 space-y-5" role="alert">
        <p class="text-4xl" aria-hidden="true">☁️</p>
        <p id="ac-error-message" class="text-lg sm:text-xl font-bold font-huninn tracking-wider text-[#2E2A4F] dark:text-white" data-error-message></p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <button type="button" data-action="retry" class="inline-flex items-center gap-1.5 bg-[#80A9D4] hover:bg-[#6b97c4] text-white px-7 py-2.5 rounded-full font-huninn font-bold tracking-widest shadow-sm hover:shadow-md transition-all duration-200 active:scale-95 cursor-pointer" hidden>
            {UI_TEXT.retry}
          </button>
          <button type="button" data-action="again" class="ac-secondary-btn">{UI_TEXT.again}</button>
        </div>
      </div>
    </section>

    <noscript>
      <p class="text-center text-sm sm:text-base text-[#3A3A3A]/75 dark:text-white/70 font-huninn tracking-wide py-14">
        {UI_TEXT.noscript}
      </p>
    </noscript>

    <p class="text-center text-xs sm:text-sm text-[#3A3A3A]/60 dark:text-white/50 font-huninn tracking-wide transition-colors mt-12 sm:mt-16">
      {PLACEHOLDER_NOTE}
    </p>

    <!-- 結果區：單張牌模板（前端 clone 填入） -->
    <template id="ac-card-template">
      <figure class="flex flex-col items-center gap-2.5">
        <figcaption class="text-sm sm:text-base font-huninn tracking-wider text-[#80A9D4] dark:text-[#8FB8E8]" data-deck-name></figcaption>
        <div class="ac-flip" data-flip>
          <div class="ac-flip-inner">
            <div class="ac-card-back ac-flip-back" aria-hidden="true"></div>
            <div class="ac-card-face ac-flip-front">
              <span class="ac-face-symbol" data-symbol aria-hidden="true"></span>
              <span class="ac-face-name" data-face-name></span>
            </div>
          </div>
        </div>
        <div class="text-center leading-snug">
          <p class="font-bold font-huninn tracking-wider text-[#2E2A4F] dark:text-white" data-name-zh></p>
          <p class="text-xs text-[#3A3A3A]/65 dark:text-white/60 font-['Quicksand']" data-name-en></p>
        </div>
      </figure>
    </template>

    <!-- 結果區：結尾（告知、導流 CTA、再抽一次） -->
    <template id="ac-outro-template">
      <div class="ac-fade space-y-6">
        <p class="text-xs sm:text-sm text-center text-[#3A3A3A]/60 dark:text-white/50" data-notice></p>
        <div class="rounded-3xl p-6 sm:p-8 text-center space-y-4 bg-gradient-to-br from-[#2E2A4F] to-[#3D3A63] text-white shadow-xl">
          <p class="text-xl sm:text-2xl font-bold font-huninn tracking-wider">{UI_TEXT.ctaTitle}</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href={LINE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#FCE794] hover:bg-[#F5D96A] text-[#2E2A4F] px-7 py-3 rounded-full font-huninn font-bold tracking-wider shadow-sm hover:shadow-md transition-all active:scale-95">
              <span>✦</span><span>{UI_TEXT.ctaButton}</span>
            </a>
            <button type="button" data-action="again" class="inline-flex items-center gap-1.5 border-2 border-white/50 hover:border-white text-white px-7 py-2.5 rounded-full font-huninn font-bold tracking-wider transition-all active:scale-95 cursor-pointer">
              {UI_TEXT.again}
            </button>
          </div>
        </div>
      </div>
    </template>
  </div>

  <script>
    import '../scripts/astro-cards';
  </script>
</Layout>

<style is:global>
  .ac-secondary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1.75rem;
    border-radius: 9999px;
    border: 2px solid #80a9d4;
    color: #80a9d4;
    font-family: var(--font-huninn);
    font-weight: 700;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s;
  }
  .ac-secondary-btn:hover { background: #80a9d4; color: #fff; }
  .dark .ac-secondary-btn { border-color: #8fb8e8; color: #8fb8e8; }
  .dark .ac-secondary-btn:hover { background: #8fb8e8; color: #2e2a4f; }

  /* ---------- 牌背（品牌佔位視覺，CSS 繪製；data-mark 區分三疊牌） ---------- */
  .ac-card-back {
    position: relative;
    border-radius: 0.75rem;
    background:
      radial-gradient(circle at 22% 18%, rgba(255, 255, 255, 0.7) 0 1.2%, transparent 1.6%),
      radial-gradient(circle at 78% 30%, rgba(255, 255, 255, 0.55) 0 1%, transparent 1.4%),
      radial-gradient(circle at 30% 80%, rgba(143, 184, 232, 0.8) 0 1.2%, transparent 1.6%),
      radial-gradient(circle at 70% 75%, rgba(255, 255, 255, 0.5) 0 0.9%, transparent 1.3%),
      linear-gradient(160deg, #3d3a63 0%, #2e2a4f 55%, #1c1834 100%);
    border: 2px solid rgba(252, 231, 148, 0.7);
    box-shadow: inset 0 0 0 4px #2e2a4f, inset 0 0 0 5px rgba(252, 231, 148, 0.45), 0 6px 16px rgba(46, 42, 79, 0.25);
  }
  .ac-card-back::after {
    content: attr(data-mark);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fce794;
    font-size: 1.35rem;
    font-family: 'Segoe UI Symbol', 'Apple Symbols', 'Noto Sans Symbols', serif;
  }

  /* ---------- 牌槽 ---------- */
  .ac-slot-box {
    position: relative;
    display: block;
    width: 3.75rem;
    height: 5.75rem;
    border-radius: 0.75rem;
    border: 2px dashed rgba(128, 169, 212, 0.55);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .dark .ac-slot-box { border-color: rgba(255, 255, 255, 0.25); }
  @media (min-width: 640px) {
    .ac-slot-box { width: 4.5rem; height: 7rem; }
  }
  .ac-slot-label { color: rgba(58, 58, 58, 0.55); transition: color 0.3s; }
  .dark .ac-slot-label { color: rgba(255, 255, 255, 0.5); }
  .ac-slot.is-current .ac-slot-box { border-color: #80a9d4; box-shadow: 0 0 0 3px rgba(128, 169, 212, 0.25); }
  .dark .ac-slot.is-current .ac-slot-box { border-color: #fce794; box-shadow: 0 0 0 3px rgba(252, 231, 148, 0.2); }
  .ac-slot.is-current .ac-slot-label,
  .ac-slot.is-filled .ac-slot-label { color: #2e2a4f; font-weight: 700; }
  .dark .ac-slot.is-current .ac-slot-label,
  .dark .ac-slot.is-filled .ac-slot-label { color: #fff; }
  .ac-slot-card {
    position: absolute;
    inset: -2px;
    display: none;
  }
  .ac-slot-card::after { font-size: 1.1rem; }
  .ac-slot.is-filled .ac-slot-box { border-color: transparent; }
  .ac-slot.is-filled .ac-slot-card { display: block; animation: ac-slot-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .ac-slot.is-waiting .ac-slot-card { animation: ac-glow 1.6s ease-in-out infinite; }

  @keyframes ac-slot-in {
    from { opacity: 0; transform: translateY(1.5rem) scale(0.85); }
    to { opacity: 1; transform: none; }
  }
  @keyframes ac-glow {
    50% { filter: drop-shadow(0 0 14px rgba(252, 231, 148, 1)); }
  }

  /* ---------- 扇形牌堆（一次一疊） ---------- */
  .ac-fan {
    --fan-spread: 20deg;
    --card-w: 4rem;
    --card-h: 6.25rem;
    position: relative;
    height: calc(var(--card-h) + 3rem);
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
  }
  .ac-fan:empty { height: 0; }
  @media (min-width: 640px) {
    .ac-fan { --fan-spread: 28deg; --card-w: 5rem; --card-h: 7.75rem; }
  }
  .ac-fan-card {
    position: absolute;
    left: calc(50% - var(--card-w) / 2);
    bottom: 0;
    width: var(--card-w);
    height: var(--card-h);
    transform-origin: 50% 330%;
    transform: rotate(calc(var(--fan-spread) * (var(--t) * 2 - 1)));
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.3s, box-shadow 0.3s, opacity 0.3s;
    cursor: pointer;
  }
  .ac-fan-card:disabled { cursor: default; }
  .ac-fan-card:not(:disabled):hover,
  .ac-fan-card:not(:disabled):focus-visible {
    transform: rotate(calc(var(--fan-spread) * (var(--t) * 2 - 1))) translateY(-0.75rem);
    outline: none;
  }
  .ac-fan-card:focus-visible { box-shadow: 0 0 0 3px #80a9d4; }
  .ac-fan-card[aria-pressed='true'] {
    transform: rotate(calc(var(--fan-spread) * (var(--t) * 2 - 1))) translateY(-2rem);
    filter: drop-shadow(0 0 10px rgba(252, 231, 148, 0.9));
  }
  .ac-fan-card:disabled:not([aria-pressed='true']) { opacity: 0.85; }
  .ac-fan.is-stacked .ac-fan-card { transform: rotate(0deg); }

  /* 等待動畫：三顆繞行的星點 */
  .ac-orbit {
    position: relative;
    display: inline-block;
    width: 3rem;
    height: 3rem;
    animation: ac-spin 2.4s linear infinite;
  }
  .ac-orbit span {
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #80a9d4;
  }
  .dark .ac-orbit span { background: #fce794; }
  .ac-orbit span:nth-child(1) { top: 0; left: calc(50% - 0.25rem); }
  .ac-orbit span:nth-child(2) { bottom: 0.3rem; left: 0.2rem; opacity: 0.7; }
  .ac-orbit span:nth-child(3) { bottom: 0.3rem; right: 0.2rem; opacity: 0.45; }
  @keyframes ac-spin { to { transform: rotate(360deg); } }

  /* ---------- 翻牌 ---------- */
  .ac-flip {
    width: 5.5rem;
    height: 8.5rem;
    perspective: 900px;
  }
  @media (min-width: 640px) {
    .ac-flip { width: 8rem; height: 12.5rem; }
  }
  .ac-flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ac-flip.is-flipped .ac-flip-inner { transform: rotateY(180deg); }
  .ac-flip-back,
  .ac-flip-front {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .ac-flip-front { transform: rotateY(180deg); }

  /* 佔位牌面：大型占星符號＋牌名 */
  .ac-card-face {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 0.35rem;
    border-radius: 0.75rem;
    background: linear-gradient(170deg, #ffffff 0%, #eaf3f8 100%);
    border: 2px solid #80a9d4;
    box-shadow: inset 0 0 0 4px #fff, inset 0 0 0 5px rgba(128, 169, 212, 0.5), 0 6px 16px rgba(46, 42, 79, 0.2);
    color: #2e2a4f;
    text-align: center;
  }
  .dark .ac-card-face {
    background: linear-gradient(170deg, #3d3a63 0%, #231f40 100%);
    border-color: #fce794;
    box-shadow: inset 0 0 0 4px #231f40, inset 0 0 0 5px rgba(252, 231, 148, 0.45), 0 6px 16px rgba(0, 0, 0, 0.35);
    color: #fff;
  }
  .ac-face-symbol {
    font-family: 'Segoe UI Symbol', 'Apple Symbols', 'Noto Sans Symbols', serif;
    font-size: 2.25rem;
    line-height: 1;
    color: #80a9d4;
  }
  .dark .ac-face-symbol { color: #fce794; }
  .ac-face-name { font-family: var(--font-huninn); font-size: 0.8rem; letter-spacing: 0.05em; }
  @media (min-width: 640px) {
    .ac-face-symbol { font-size: 3.25rem; }
    .ac-face-name { font-size: 0.95rem; }
  }

  .ac-fade { animation: ac-fade-in 0.7s ease-out both; }
  @keyframes ac-fade-in {
    from { opacity: 0; transform: translateY(0.75rem); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ac-fan-card,
    .ac-flip-inner { transition: none; }
    .ac-slot.is-filled .ac-slot-card { animation: ac-fade-plain 0.4s ease-out both; }
    .ac-slot.is-waiting .ac-slot-card,
    .ac-orbit { animation: none; }
    .ac-fade { animation: ac-fade-plain 0.4s ease-out both; }
    @keyframes ac-fade-plain { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
