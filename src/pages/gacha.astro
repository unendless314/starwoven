---
import Layout from '../layouts/Layout.astro';
import { CODE_MAX_LENGTH } from '../lib/gacha/config';
import { PAGE_META, UI_TEXT } from '../lib/gacha/copy';

const LINE_URL = 'https://line.me/R/ti/p/@347fucvj?ts=07031038&oat_content=url';
const isDemo = !import.meta.env.PUBLIC_GACHA_API_URL;
---

<Layout title={PAGE_META.title} description={PAGE_META.description} theme="auto" noindex>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20" data-gacha-root>
    <header class="text-center max-w-3xl mx-auto mb-8 sm:mb-12 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-star-gold/30 dark:bg-star-gold/15 border border-star-gold/45 text-star-indigo-dark dark:text-star-gold text-xs sm:text-sm font-huninn tracking-widest">
        <span aria-hidden="true">✦</span>
        <span>{UI_TEXT.badge}</span>
        <span aria-hidden="true">✦</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold font-huninn text-heading tracking-wider">{UI_TEXT.heading}</h1>
      <p class="text-lg sm:text-xl text-body font-light leading-relaxed tracking-wide">
        {UI_TEXT.intro[0]}<br class="hidden sm:inline" />
        {UI_TEXT.intro[1]}
      </p>
      <div class="w-20 h-1.5 bg-star-gold mx-auto rounded-full opacity-80"></div>
    </header>

    {isDemo && (
      <aside class="max-w-2xl mx-auto mb-6 rounded-2xl border border-star-gold/55 bg-star-gold/20 dark:bg-star-gold/10 px-5 py-4 text-center" data-demo-banner>
        <p class="font-bold font-huninn tracking-wide text-heading">{UI_TEXT.demoBadge}</p>
        <p class="mt-1 text-sm leading-relaxed text-body">{UI_TEXT.demoGuide}</p>
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          {['DEMO', 'ONCE', 'ENDED', 'EMPTY'].map((code) => (
            <button type="button" data-demo-code={code} class="rounded-full border border-line-strong bg-card-solid px-3 py-1 text-sm font-bold text-emphasis hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-blue cursor-pointer">
              {code}
            </button>
          ))}
        </div>
      </aside>
    )}

    <section data-step="setup" aria-labelledby="gacha-setup-title" class="gacha-panel">
      <div class="max-w-2xl mx-auto rounded-3xl border border-line-strong bg-card-solid shadow-xl p-6 sm:p-10">
        <h2 id="gacha-setup-title" class="text-center text-xl sm:text-2xl font-bold font-huninn tracking-wide text-heading">準備好了嗎？</h2>
        <div class="my-7" data-gacha-machine aria-hidden="true">
          <div class="gacha-machine__globe">
            <span class="gacha-capsule"></span><span class="gacha-capsule"></span><span class="gacha-capsule"></span>
            <span class="gacha-capsule"></span><span class="gacha-capsule"></span><span class="gacha-capsule"></span>
          </div>
          <div class="gacha-machine__body">
            <div class="gacha-machine__knob"><span></span></div>
            <div class="gacha-machine__chute"></div>
          </div>
          <div class="gacha-machine__base"></div>
        </div>

        <form id="gacha-form" class="space-y-5" novalidate>
          <div>
            <label for="gacha-code" class="block text-lg font-bold font-huninn tracking-wide text-heading mb-2">{UI_TEXT.codeLabel}</label>
            <input
              id="gacha-code"
              name="code"
              type="text"
              inputmode="text"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              maxlength={CODE_MAX_LENGTH}
              placeholder={UI_TEXT.codePlaceholder}
              aria-describedby="gacha-code-help"
              class="w-full rounded-2xl border border-line-strong bg-card-solid px-4 py-3.5 text-center text-lg sm:text-xl font-bold tracking-[0.18em] uppercase text-heading placeholder:text-sm placeholder:font-normal placeholder:tracking-normal placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent-blue dark:focus:ring-moon-blue"
            />
            <p id="gacha-code-help" class="mt-2 text-sm leading-relaxed text-muted">{UI_TEXT.codeHelp}</p>
          </div>
          <div class="text-center">
            <button type="submit" data-submit class="inline-flex items-center justify-center gap-2 rounded-full bg-accent-blue hover:bg-accent-blue-soft px-10 py-3.5 text-lg font-bold font-huninn tracking-widest text-star-indigo-dark shadow-lg hover:shadow-xl transition-all duration-200 active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed cursor-pointer">
              <span aria-hidden="true">✦</span>
              <span>{UI_TEXT.startButton}</span>
            </button>
          </div>
        </form>
      </div>
    </section>

    <section data-step="ritual" aria-labelledby="gacha-ritual-status" class="gacha-panel" hidden>
      <div class="max-w-2xl mx-auto rounded-3xl border border-line-strong bg-card-solid shadow-xl p-6 sm:p-10 text-center">
        <h2 id="gacha-ritual-status" class="text-xl sm:text-2xl font-bold font-huninn tracking-wide text-heading" aria-live="polite">{UI_TEXT.ritualStatus}</h2>
        <div class="my-8 is-spinning" data-gacha-ritual-machine aria-hidden="true">
          <div class="gacha-machine__globe">
            <span class="gacha-capsule"></span><span class="gacha-capsule"></span><span class="gacha-capsule"></span>
            <span class="gacha-capsule"></span><span class="gacha-capsule"></span><span class="gacha-capsule"></span>
          </div>
          <div class="gacha-machine__body">
            <div class="gacha-machine__knob"><span></span></div>
            <div class="gacha-machine__chute"></div>
          </div>
          <div class="gacha-machine__base"></div>
        </div>
        <div class="gacha-stars" aria-hidden="true"><span></span><span></span><span></span></div>
      </div>
    </section>

    <section data-step="result" aria-labelledby="gacha-result-prize" class="gacha-panel" hidden>
      <div class="max-w-2xl mx-auto rounded-3xl border border-line-strong bg-card-solid shadow-xl p-6 sm:p-10 text-center">
        <div class="gacha-result-capsule" aria-hidden="true"><span>✦</span></div>
        <p class="text-sm sm:text-base font-huninn tracking-[0.25em] text-emphasis">{UI_TEXT.resultEyebrow}</p>
        <h2 id="gacha-result-prize" class="mt-2 text-3xl sm:text-4xl font-bold font-huninn tracking-wider text-heading" data-result-prize></h2>

        <div class="mt-7 rounded-2xl border border-line bg-tint px-4 py-5">
          <p class="text-sm font-huninn tracking-widest text-muted">{UI_TEXT.resultIdLabel}</p>
          <p class="mt-1 select-all break-all text-2xl sm:text-3xl font-bold tabular-nums tracking-[0.12em] text-heading" data-result-id></p>
          <button type="button" data-action="copy" class="mt-3 rounded-full border border-line-strong bg-card-solid px-4 py-1.5 text-sm font-bold text-emphasis hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-blue cursor-pointer">
            <span data-copy-label>{UI_TEXT.copyButton}</span>
          </button>
        </div>

        <p class="mt-5 leading-relaxed text-body">{UI_TEXT.resultGuide}</p>
        <p class="mt-3 text-sm font-bold text-emphasis" data-result-repeated hidden></p>
        <p class="mt-4 rounded-2xl border border-star-gold/45 bg-star-gold/15 px-4 py-3 text-sm leading-relaxed text-body" data-result-public hidden>{UI_TEXT.publicNote}</p>

        <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href={LINE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-full bg-[#06C755] hover:bg-[#05b04c] px-7 py-3 font-bold font-huninn tracking-wider text-white shadow-sm hover:shadow-md transition-all active:scale-95">
            {UI_TEXT.lineButton}
          </a>
          <button type="button" data-action="reset" class="gacha-secondary-btn">{UI_TEXT.resetButton}</button>
        </div>
      </div>
    </section>

    <section data-step="error" aria-labelledby="gacha-error-heading" class="gacha-panel" hidden>
      <div class="max-w-xl mx-auto rounded-3xl border border-line-strong bg-card-solid shadow-xl p-6 sm:p-10 text-center" role="alert">
        <div class="gacha-error-mark" aria-hidden="true">!</div>
        <h2 id="gacha-error-heading" class="text-xl sm:text-2xl font-bold font-huninn tracking-wide text-heading">{UI_TEXT.errorHeading}</h2>
        <p class="mt-4 leading-relaxed text-body" data-error-message></p>
        <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-3">
          <button type="button" data-action="retry" class="inline-flex rounded-full bg-accent-blue hover:bg-accent-blue-soft px-7 py-3 font-bold font-huninn tracking-wider text-star-indigo-dark transition-all active:scale-95 cursor-pointer" hidden>{UI_TEXT.retryButton}</button>
          <button type="button" data-action="reset" class="gacha-secondary-btn">{UI_TEXT.editButton}</button>
        </div>
      </div>
    </section>

    <noscript>
      <p class="text-center text-muted py-10">星靈扭蛋需要啟用 JavaScript 才能使用。</p>
    </noscript>
  </div>

  <script>
    import '../scripts/gacha';
  </script>
</Layout>

<style>
  .gacha-panel { scroll-margin-top: 7rem; }
  .gacha-panel h2:focus { outline: none; }
  .gacha-secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-accent-blue-deep);
    border-radius: 9999px;
    padding: 0.75rem 1.5rem;
    color: var(--color-emphasis);
    background: var(--color-card-solid);
    font-family: var(--font-huninn);
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.2s;
  }
  .gacha-secondary-btn:hover { background: var(--color-tint); }
  .gacha-secondary-btn:active { transform: scale(0.97); }
  .gacha-secondary-btn:focus-visible { outline: 2px solid var(--color-accent-blue); outline-offset: 3px; }

  [data-gacha-machine], [data-gacha-ritual-machine] { width: 15rem; margin-inline: auto; }
  .gacha-machine__globe {
    position: relative;
    z-index: 1;
    width: 11rem;
    height: 11rem;
    margin-inline: auto;
    overflow: hidden;
    border: 5px solid var(--color-accent-blue);
    border-radius: 9999px;
    background: linear-gradient(145deg, rgb(255 255 255 / 0.9), var(--color-light-bg));
    box-shadow: inset 0 0 1.5rem rgb(255 255 255 / 0.8), 0 0.5rem 1.5rem rgb(46 42 79 / 0.12);
  }
  .dark .gacha-machine__globe { background: linear-gradient(145deg, var(--color-star-indigo), var(--color-dark-card)); border-color: var(--color-moon-blue); }
  .gacha-machine__globe::after {
    content: '';
    position: absolute;
    top: 1rem;
    left: 1.5rem;
    width: 3rem;
    height: 1.2rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
    transform: rotate(-35deg);
  }
  .gacha-capsule {
    position: absolute;
    width: 3rem;
    height: 3rem;
    border: 2px solid rgb(46 42 79 / 0.18);
    border-radius: 50%;
    background: linear-gradient(to bottom, #fff 0 48%, var(--capsule-color, var(--color-star-gold)) 48% 100%);
    box-shadow: 0 0.2rem 0.35rem rgb(46 42 79 / 0.18);
  }
  .gacha-capsule:nth-child(1) { left: 1rem; top: 4.8rem; --capsule-color: #F3D9E4; transform: rotate(18deg); }
  .gacha-capsule:nth-child(2) { left: 3.7rem; top: 5.8rem; --capsule-color: var(--color-star-gold); transform: rotate(-12deg); }
  .gacha-capsule:nth-child(3) { right: 0.8rem; top: 4.7rem; --capsule-color: #B3D2EA; transform: rotate(24deg); }
  .gacha-capsule:nth-child(4) { left: 2rem; top: 2.2rem; --capsule-color: #C4B4DC; transform: rotate(-20deg); }
  .gacha-capsule:nth-child(5) { right: 2rem; top: 2rem; --capsule-color: #A8D8CC; transform: rotate(12deg); }
  .gacha-capsule:nth-child(6) { left: 4rem; top: 3.8rem; --capsule-color: #EFC09C; transform: rotate(35deg); }
  .gacha-machine__body {
    position: relative;
    width: 10rem;
    height: 7.5rem;
    margin: -0.5rem auto 0;
    border: 4px solid var(--color-accent-blue);
    border-radius: 1rem 1rem 2rem 2rem;
    background: var(--color-card-solid);
    box-shadow: 0 0.6rem 1.2rem rgb(46 42 79 / 0.15);
  }
  .dark .gacha-machine__body { border-color: var(--color-moon-blue); }
  .gacha-machine__knob {
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    margin: 0.7rem auto 0;
    border: 4px solid var(--color-star-indigo-dark);
    border-radius: 50%;
    background: var(--color-star-gold);
  }
  .dark .gacha-machine__knob { border-color: var(--color-star-gold); }
  .gacha-machine__knob span { width: 2.2rem; height: 0.45rem; border-radius: 9999px; background: var(--color-star-indigo-dark); }
  .gacha-machine__chute { width: 3.8rem; height: 1.3rem; margin: 0.5rem auto 0; border-radius: 0.5rem; background: var(--color-star-indigo-dark); box-shadow: inset 0 0.2rem 0.4rem rgb(0 0 0 / 0.3); }
  .dark .gacha-machine__chute { background: var(--color-night-deep); }
  .gacha-machine__base { width: 12rem; height: 0.8rem; margin: -0.1rem auto 0; border-radius: 9999px; background: var(--color-accent-blue); }
  .dark .gacha-machine__base { background: var(--color-moon-blue); }

  .is-spinning .gacha-capsule:nth-child(odd) { animation: gacha-shake-a 0.55s ease-in-out infinite; }
  .is-spinning .gacha-capsule:nth-child(even) { animation: gacha-shake-b 0.48s ease-in-out infinite; }
  .is-spinning .gacha-machine__knob { animation: gacha-turn 1.1s ease-in-out infinite; }
  @keyframes gacha-shake-a { 50% { translate: 0.35rem -0.65rem; rotate: 20deg; } }
  @keyframes gacha-shake-b { 50% { translate: -0.4rem 0.5rem; rotate: -18deg; } }
  @keyframes gacha-turn { 50%, 100% { transform: rotate(180deg); } }

  .gacha-stars { display: flex; justify-content: center; gap: 0.8rem; }
  .gacha-stars span { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--color-accent-blue); animation: gacha-pulse 1.2s ease-in-out infinite; }
  .gacha-stars span:nth-child(2) { animation-delay: 0.2s; }
  .gacha-stars span:nth-child(3) { animation-delay: 0.4s; }
  .dark .gacha-stars span { background: var(--color-star-gold); }
  @keyframes gacha-pulse { 50% { opacity: 0.25; transform: translateY(-0.35rem); } }

  .gacha-result-capsule {
    display: grid;
    place-items: center;
    width: 7rem;
    height: 7rem;
    margin: 0 auto 1.5rem;
    border: 3px solid var(--color-accent-blue);
    border-radius: 50%;
    background: linear-gradient(to bottom, var(--color-card-solid) 0 48%, var(--color-star-gold) 48% 100%);
    box-shadow: 0 0 2rem rgb(252 231 148 / 0.45);
    color: var(--color-star-indigo-dark);
    font-size: 2.5rem;
    animation: gacha-reveal 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes gacha-reveal { from { opacity: 0; transform: translateY(1rem) scale(0.6) rotate(-25deg); } to { opacity: 1; transform: none; } }
  .gacha-error-mark { display: grid; place-items: center; width: 4rem; height: 4rem; margin: 0 auto 1.5rem; border-radius: 50%; background: var(--color-tint); color: var(--color-emphasis); font-size: 2rem; font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .is-spinning .gacha-capsule,
    .is-spinning .gacha-machine__knob,
    .gacha-stars span { animation: none; }
    .gacha-result-capsule { animation: none; }
    .gacha-secondary-btn { transition: none; }
  }
</style>
