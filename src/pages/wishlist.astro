---
import Layout from '../layouts/Layout.astro';
import CourseWishlistCard from '../components/CourseWishlistCard.astro';

// ==========================================
// 課程許願池（SSR 不寫死課程）：首屏僅渲染骨架卡佔位（data-wish-skeleton），
// 進站後由 CourseWishlistCard 內的 get_all 同步動態建立全部卡片；
// API 失敗則顯示 #wish-error 錯誤區塊。Demo 模式（未設 API 網址）由元件內 DEMO_COURSES 驅動。
// ==========================================
---

<Layout
  title="課程許願池 — 星靈織語 Starwoven"
  description="按下「我想一起」為心儀的課程集氣，集滿人數即刻開班！星靈織語課程許願池，讓想上的課被看見。"
  theme="auto"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">

    <!-- 頁頭 Header -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#FCE794]/30 dark:bg-[#FCE794]/15 border border-[#F5A623]/40 dark:border-[#FCE794]/30 text-[#2E2A4F]/85 dark:text-[#FCE794] text-xs sm:text-sm font-huninn tracking-widest transition-colors">
        <span>✦</span>
        <span>敲碗開課・集氣許願</span>
        <span>✦</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wider transition-colors">
        課程許願池
      </h1>
      <p class="text-lg sm:text-xl text-[#3A3A3A]/85 dark:text-white/85 font-light leading-relaxed tracking-wide transition-colors">
        有人跟你想的一樣，我們來促成它。<br class="hidden sm:inline" />
        按下「我想一起」為心儀的課程集氣，集滿人數即刻開班！
      </p>
      <div class="w-20 h-1.5 bg-[#FCE794] mx-auto rounded-full mt-3 opacity-80"></div>
    </header>

    <!-- 導引列（左側說明、右側「我想許願」LINE 按鈕） -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 sm:mb-12 border-b border-[#F5A623]/25 dark:border-white/10 pb-5">
      <p class="text-sm sm:text-base text-[#3A3A3A]/75 dark:text-white/70 font-light tracking-wide transition-colors">
        想許願的課程不在清單中？歡迎透過 LINE 官方帳號提案，我們會定期評估加入許願池。
      </p>
      <a
        href="https://line.me/R/ti/p/@347fucvj?ts=07031038&oat_content=url"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 self-start sm:self-auto shrink-0 bg-[#FCE794] hover:bg-[#F5D96A] text-[#2E2A4F] px-6 py-2.5 rounded-full font-huninn font-bold tracking-wider text-base shadow-sm hover:shadow-md transition-all duration-300"
      >
        <span>✦</span>
        <span>我想許願</span>
      </a>
    </div>

    <!-- 許願課程卡片 Grid（桌機 3 欄、平板 2 欄、手機 1 欄）
         data-wish-grid：供進站同步時動態插入新卡片與搬移排序（順序 = 試算表列順序）。
         SSR 僅放骨架卡佔位（data-wish-skeleton，首次同步成功後由前端移除），不寫死課程內容 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6" data-wish-grid>
      {Array.from({ length: 6 }).map(() => (
        <div
          class="bg-white/95 dark:bg-[#231f40]/95 backdrop-blur-md rounded-3xl overflow-hidden shadow-lg border border-gray-200/80 dark:border-white/20 flex flex-col animate-pulse"
          data-wish-skeleton
          aria-hidden="true"
        >
          <div class="w-full aspect-16/10 bg-[#3A3A3A]/10 dark:bg-white/10"></div>
          <div class="p-5 sm:p-6 flex-1 flex flex-col gap-3">
            <div class="space-y-2">
              <div class="h-5 sm:h-6 w-3/4 rounded bg-[#3A3A3A]/10 dark:bg-white/10"></div>
              <div class="h-3.5 w-1/3 rounded bg-[#3A3A3A]/10 dark:bg-white/10"></div>
              <div class="h-3.5 w-1/2 rounded bg-[#3A3A3A]/10 dark:bg-white/10"></div>
              <div class="h-3.5 w-2/5 rounded bg-[#3A3A3A]/10 dark:bg-white/10"></div>
            </div>
            <div class="h-2.5 w-full rounded-full bg-[#3A3A3A]/10 dark:bg-white/10"></div>
            <div class="mt-auto h-10 sm:h-11 w-full rounded-full bg-[#3A3A3A]/10 dark:bg-white/10"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- 初始載入失敗錯誤區塊（預設隱藏；API 無回應且頁面尚無卡片時由前端顯示） -->
    <div id="wish-error" class="hidden text-center py-14 sm:py-20 space-y-4">
      <p class="text-4xl" aria-hidden="true">☁️</p>
      <p class="text-lg sm:text-xl font-bold font-huninn text-[#2E2A4F] dark:text-white tracking-wider transition-colors">
        許願池暫時連線異常
      </p>
      <p class="text-sm sm:text-base text-[#3A3A3A]/70 dark:text-white/70 font-light tracking-wide transition-colors">
        課程清單載入失敗，請稍候片刻後重新整理頁面。
      </p>
      <button
        type="button"
        id="wish-error-reload"
        class="inline-flex items-center gap-1.5 bg-[#80A9D4] hover:bg-[#6b97c4] text-white px-6 py-2.5 rounded-full font-huninn font-bold tracking-widest text-sm sm:text-base shadow-sm hover:shadow-md transition-all duration-200 active:scale-95 cursor-pointer"
      >
        重新整理
      </button>
    </div>

    <noscript>
      <p class="text-center text-sm sm:text-base text-[#3A3A3A]/75 dark:text-white/70 font-huninn tracking-wide py-14">
        許願池需要啟用 JavaScript 才能顯示課程清單與投票。
      </p>
    </noscript>

    <!-- 動態卡片模板：以 CourseWishlistCard 實際渲染一份佔位卡片，
         <template> 內容為 inert 不會顯示；所有課程卡片皆由前端 clone 此模板建立（單一版型來源） -->
    <template id="wish-card-template">
      <CourseWishlistCard
        id="0"
        title="課程載入中"
        teacher=""
        duration=""
        price=""
        votes={0}
        threshold={1}
        icon="✦"
        gradient="from-[#D9E9F6] to-[#B3D2EA]"
      />
    </template>

    <!-- 許願池互動邏輯（頁面層級 script，Astro 打包後注入頁尾）：
         不可放回 CourseWishlistCard 元件內——元件僅被 <template> 使用時，
         Astro 會把元件 <script> 標籤插進 <template> 內成為 inert，永不執行 -->
    <script>
      import '../scripts/wishlist';
    </script>

    <p class="text-center text-xs sm:text-sm text-[#3A3A3A]/60 dark:text-white/50 font-huninn tracking-wide transition-colors mt-8 sm:mt-12">
      許願僅為開課意向統計，不收取任何費用；課程達標後將於 LINE 官方帳號優先公告開課資訊。
    </p>
  </div>
</Layout>
