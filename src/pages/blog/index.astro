---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';

// 取得所有文章並依發布日期由新到舊排序
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = sortedPosts.find((p) => p.data.featured) || sortedPosts[0];
const regularPosts = sortedPosts.filter((p) => p.id !== featuredPost?.id);

// 收集所有文章分類
const categories = ['全部', ...Array.from(new Set(allPosts.map((p) => p.data.category)))];

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-TW', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
};
---

<Layout
  title="星靈專欄 — 星靈織語 Starwoven"
  description="探索星靈織語的靈性專欄：包含光與阿卡西紀錄、靈氣療癒、脈輪平衡、偉特與托特塔羅解讀等深度文章，陪伴你開啟內在覺察，找回心靈的力量。"
  theme="auto"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <!-- Header -->
    <header class="text-center max-w-2xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium tracking-widest text-[#80A9D4] dark:text-[#8FB8E8] bg-[#80A9D4]/15 dark:bg-white/10 border border-[#80A9D4]/30 dark:border-white/15">
        <span>✦</span>
        <span>STARWOVEN BLOG</span>
        <span>✦</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-[#2E2A4F] dark:text-white tracking-wider transition-colors">
        星靈專欄
      </h1>
      <p class="text-base sm:text-lg text-[#3A3A3A]/80 dark:text-white/80 leading-relaxed transition-colors">
        每一篇文字，都是一場心靈的對話與自我照見。<br class="hidden sm:inline" />
        在星光與墨色之中，陪伴你梳理內在思緒，找回生活的寧靜與力量。
      </p>
      <div class="w-16 h-1 bg-[#80A9D4] mx-auto rounded-full"></div>
    </header>

    <!-- 分類快速過濾按鈕列 -->
    <div class="flex items-center justify-center flex-wrap gap-2.5 mb-12">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category-btn={cat}
          class:list={[
            'category-filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer border',
            idx === 0
              ? 'active-filter bg-[#2E2A4F] text-white border-[#2E2A4F] dark:bg-[#8FB8E8] dark:text-[#2E2A4F] dark:border-[#8FB8E8] shadow-xs'
              : 'bg-white/70 text-[#3A3A3A] border-[#80A9D4]/25 hover:bg-white dark:bg-white/10 dark:text-white/80 dark:border-white/15 dark:hover:bg-white/20'
          ]}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- 置頂精選文章（Featured Post） -->
    {featuredPost && (
      <section
        id="featured-post-card"
        data-category={featuredPost.data.category}
        class="blog-article-item mb-14 bg-white/85 dark:bg-white/10 rounded-3xl border border-[#80A9D4]/25 dark:border-white/15 p-6 sm:p-10 shadow-sm transition-all hover:border-[#80A9D4]/50 dark:hover:border-white/30"
      >
        <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-stretch">
          <!-- 氛圍插圖佔位/標籤區 -->
          <div class="lg:w-5/12 min-h-[220px] sm:min-h-[260px] rounded-2xl bg-gradient-to-br from-[#80A9D4]/20 via-[#EAF3F8] to-[#2E2A4F]/10 dark:from-[#3D3A63] dark:via-[#2E2A4F] dark:to-[#1E1B3A] p-6 flex flex-col justify-between border border-[#80A9D4]/20 dark:border-white/10 relative overflow-hidden group">
            {featuredPost.data.coverImage ? (
              <img
                src={featuredPost.data.coverImage}
                alt={featuredPost.data.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : null}
            <div class="absolute -right-8 -bottom-8 w-44 h-44 rounded-full bg-[#8FB8E8]/20 dark:bg-white/5 blur-2xl pointer-events-none"></div>
            <div class="flex items-center justify-between z-10">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#2E2A4F] text-[#FCE794] dark:bg-white/20 dark:text-[#FCE794] shadow-xs">
                <span>✦</span>
                <span>精選專文</span>
              </span>
              <span class="text-xs text-[#80A9D4] dark:text-[#8FB8E8] font-medium tracking-wide">
                {featuredPost.data.category}
              </span>
            </div>

            <!-- 星靈靈性幾何符號圖示 -->
            {!featuredPost.data.coverImage && (
              <div class="my-auto py-6 flex justify-center items-center z-10">
                <div class="w-20 h-20 rounded-full border border-[#80A9D4]/40 dark:border-white/20 flex items-center justify-center bg-white/40 dark:bg-white/5 shadow-inner">
                  <CategoryIcon category={featuredPost.data.category} class="w-10 h-10 text-[#80A9D4] dark:text-[#8FB8E8] transition-transform duration-300 group-hover:scale-110" />
                </div>
              </div>
            )}

            <div class="flex items-center justify-between text-xs text-[#3A3A3A]/70 dark:text-white/60 z-10 font-medium">
              <span>{formatDate(featuredPost.data.pubDate)}</span>
              <span>預估閱讀 {featuredPost.data.readTime}</span>
            </div>
          </div>

          <!-- 內容細節區 -->
          <div class="lg:w-7/12 flex flex-col justify-between space-y-5">
            <div class="space-y-3">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="px-2.5 py-0.5 rounded-md text-xs font-semibold bg-[#80A9D4]/20 text-[#2E2A4F] dark:bg-white/15 dark:text-[#8FB8E8]">
                  {featuredPost.data.category}
                </span>
                <span class="text-xs text-[#3A3A3A]/60 dark:text-white/50">
                  {formatDate(featuredPost.data.pubDate)} · {featuredPost.data.readTime}
                </span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold text-[#2E2A4F] dark:text-white tracking-wide hover:text-[#80A9D4] dark:hover:text-[#8FB8E8] transition-colors">
                <a href={`/blog/${featuredPost.id}`}>
                  {featuredPost.data.title}
                </a>
              </h2>
              <p class="text-sm sm:text-base text-[#3A3A3A]/85 dark:text-white/80 leading-relaxed">
                {featuredPost.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-[#80A9D4]/20 dark:border-white/10 flex items-center justify-between flex-wrap gap-4">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-[#80A9D4]/20 dark:bg-white/15 flex items-center justify-center font-bold text-xs text-[#2E2A4F] dark:text-white">
                  {featuredPost.data.author.charAt(0)}
                </div>
                <div>
                  <div class="text-sm font-bold text-[#2E2A4F] dark:text-white">
                    {featuredPost.data.author}
                  </div>
                  {featuredPost.data.authorRole && (
                    <div class="text-xs text-[#80A9D4] dark:text-[#8FB8E8]">
                      {featuredPost.data.authorRole}
                    </div>
                  )}
                </div>
              </div>

              <a
                href={`/blog/${featuredPost.id}`}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold bg-[#2E2A4F] text-white hover:bg-[#3D3A63] dark:bg-white dark:text-[#2E2A4F] dark:hover:bg-[#FCE794] transition-all shadow-xs"
              >
                <span>閱讀專文</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 一般文章清單 Grid -->
    <section class="mb-16">
      <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {regularPosts.map((post) => (
          <article
            data-category={post.data.category}
            class="blog-article-item bg-white/80 dark:bg-white/10 rounded-2xl sm:rounded-3xl border border-[#80A9D4]/20 dark:border-white/15 p-5 sm:p-6 flex flex-col justify-between shadow-xs hover:shadow-md hover:border-[#80A9D4]/40 dark:hover:border-white/30 transition-all duration-200 group"
          >
            <div>
              <!-- 文章專屬封面圖槽 (16:10 寬幅比例) -->
              <a
                href={`/blog/${post.id}`}
                class="block relative aspect-16/10 rounded-xl sm:rounded-2xl overflow-hidden mb-5 bg-gradient-to-br from-[#80A9D4]/20 via-[#EAF3F8] to-[#2E2A4F]/10 dark:from-[#3D3A63] dark:via-[#2E2A4F] dark:to-[#1E1B3A] border border-[#80A9D4]/20 dark:border-white/10 group-hover:border-[#80A9D4]/40 dark:group-hover:border-white/30 transition-all shadow-xs"
              >
                {post.data.coverImage ? (
                  <img
                    src={post.data.coverImage}
                    alt={post.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex flex-col justify-between p-4 relative overflow-hidden">
                    <!-- 柔和星芒光暈背景 -->
                    <div class="absolute -right-6 -bottom-6 w-28 h-28 rounded-full bg-[#8FB8E8]/20 dark:bg-white/5 blur-xl pointer-events-none"></div>
                    <div class="absolute -left-4 -top-4 w-20 h-20 rounded-full bg-[#FCE794]/15 dark:bg-[#FCE794]/5 blur-lg pointer-events-none"></div>

                    <!-- 頂部類別與閱讀時間 -->
                    <div class="flex items-center justify-between z-10">
                      <span class="text-[11px] font-semibold tracking-wider text-[#80A9D4] dark:text-[#8FB8E8]">
                        ✦ {post.data.category}
                      </span>
                      <span class="text-[11px] text-[#3A3A3A]/60 dark:text-white/50 font-medium">
                        {post.data.readTime}
                      </span>
                    </div>

                    <!-- 中心分類靈性幾何符號圖示 -->
                    <div class="my-auto py-2 flex justify-center items-center z-10">
                      <div class="w-14 h-14 rounded-full border border-[#80A9D4]/30 dark:border-white/20 flex items-center justify-center bg-white/50 dark:bg-white/5 shadow-xs backdrop-blur-xs transition-transform duration-300 group-hover:scale-110">
                        <CategoryIcon category={post.data.category} class="w-7 h-7 text-[#80A9D4] dark:text-[#8FB8E8]" />
                      </div>
                    </div>

                    <!-- 底部細節裝飾標註 -->
                    <div class="text-[10px] text-center tracking-widest text-[#3A3A3A]/50 dark:text-white/40 uppercase z-10 font-medium">
                      Starwoven Editorial
                    </div>
                  </div>
                )}
              </a>

              <!-- 卡片中段文字資訊 -->
              <div class="space-y-3">
                <div class="flex items-center justify-between text-xs">
                  <span class="px-2.5 py-0.5 rounded-full font-semibold bg-[#80A9D4]/15 text-[#2E2A4F] dark:bg-white/15 dark:text-[#8FB8E8]">
                    {post.data.category}
                  </span>
                  <span class="text-[#3A3A3A]/60 dark:text-white/50">
                    {formatDate(post.data.pubDate)}
                  </span>
                </div>

                <h3 class="text-lg sm:text-xl font-bold text-[#2E2A4F] dark:text-white tracking-wide group-hover:text-[#80A9D4] dark:group-hover:text-[#8FB8E8] transition-colors leading-snug line-clamp-2">
                  <a href={`/blog/${post.id}`}>
                    {post.data.title}
                  </a>
                </h3>

                <p class="text-xs sm:text-sm text-[#3A3A3A]/80 dark:text-white/75 leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>

                <!-- 標籤列表 -->
                {post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <span class="text-[11px] px-2 py-0.5 rounded-md bg-[#80A9D4]/10 text-[#3A3A3A]/70 dark:bg-white/5 dark:text-white/60">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>

            <!-- 卡片底部作者與連結 -->
            <div class="pt-5 mt-5 border-t border-[#80A9D4]/15 dark:border-white/10 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-full bg-[#80A9D4]/20 dark:bg-white/15 flex items-center justify-center font-bold text-xs text-[#2E2A4F] dark:text-white">
                  {post.data.author.charAt(0)}
                </div>
                <span class="text-xs font-semibold text-[#2E2A4F] dark:text-white">
                  {post.data.author}
                </span>
              </div>
              <a
                href={`/blog/${post.id}`}
                class="text-xs font-semibold text-[#80A9D4] dark:text-[#8FB8E8] group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1"
              >
                <span>閱讀全文</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- 無相關文章提示（過濾時使用，或完全無文章時預設呈現） -->
      <div
        id="no-posts-message"
        class:list={[
          'text-center py-16 space-y-3',
          allPosts.length === 0 ? 'block' : 'hidden'
        ]}
      >
        <p class="text-lg text-[#3A3A3A]/70 dark:text-white/70">
          {allPosts.length === 0 ? '目前專欄籌備中，敬請期待全新靈性文章上線。' : '此分類目前尚無發布文章。'}
        </p>
        {allPosts.length > 0 && (
          <button
            type="button"
            id="reset-filter-btn"
            class="text-sm font-semibold text-[#80A9D4] dark:text-[#8FB8E8] hover:underline cursor-pointer"
          >
            查看全部文章
          </button>
        )}
      </div>
    </section>

    <!-- 底部諮詢預約 CTA 區塊 -->
    <section class="text-center bg-white/75 dark:bg-white/10 p-8 sm:p-12 rounded-3xl border border-[#80A9D4]/20 dark:border-white/15 max-w-2xl mx-auto space-y-5 transition-colors shadow-xs">
      <div class="w-12 h-12 rounded-full bg-[#80A9D4]/15 dark:bg-white/10 mx-auto flex items-center justify-center text-[#80A9D4] dark:text-[#8FB8E8]">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3" />
        </svg>
      </div>
      <div class="space-y-2">
        <h2 class="text-xl sm:text-2xl font-bold text-[#2E2A4F] dark:text-white transition-colors">
          在文字之外，渴望更深入的生命指引嗎？
        </h2>
        <p class="text-xs sm:text-sm text-[#3A3A3A]/80 dark:text-white/80 leading-relaxed max-w-lg mx-auto transition-colors">
          星靈織語提供一對一命理諮詢、靈氣調頻與常態研習課程，陪伴你走過人生的每一個起伏轉折。
        </p>
      </div>
      <div class="pt-2">
        <CTAButton variant="primary" text="預約專屬諮詢" />
      </div>
    </section>
  </div>

  <!-- 分類篩選客戶端微腳本 -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.category-filter-btn');
      const articleItems = document.querySelectorAll('.blog-article-item');
      const noPostsMsg = document.getElementById('no-posts-message');
      const resetBtn = document.getElementById('reset-filter-btn');

      function filterCategory(targetCat) {
        let visibleCount = 0;

        filterBtns.forEach((btn) => {
          const cat = btn.getAttribute('data-category-btn');
          if (cat === targetCat) {
            btn.classList.add('active-filter', 'bg-[#2E2A4F]', 'text-white', 'border-[#2E2A4F]', 'dark:bg-[#8FB8E8]', 'dark:text-[#2E2A4F]', 'dark:border-[#8FB8E8]');
            btn.classList.remove('bg-white/70', 'text-[#3A3A3A]', 'dark:bg-white/10', 'dark:text-white/80');
          } else {
            btn.classList.remove('active-filter', 'bg-[#2E2A4F]', 'text-white', 'border-[#2E2A4F]', 'dark:bg-[#8FB8E8]', 'dark:text-[#2E2A4F]', 'dark:border-[#8FB8E8]');
            btn.classList.add('bg-white/70', 'text-[#3A3A3A]', 'dark:bg-white/10', 'dark:text-white/80');
          }
        });

        articleItems.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (targetCat === '全部' || itemCat === targetCat) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (noPostsMsg) {
          noPostsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-category-btn');
          if (cat) filterCategory(cat);
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          filterCategory('全部');
        });
      }
    });
  </script>
</Layout>
